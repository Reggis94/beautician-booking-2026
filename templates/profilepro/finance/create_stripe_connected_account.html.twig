<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Stripe Connected Account</title>
    <style>
        body {
            margin: 0;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(160deg, #f2f6fb 0%, #e5edf8 100%);
            color: #1d2733;
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .card {
            width: 100%;
            max-width: 520px;
            background: #ffffff;
            border: 1px solid #d8e2ef;
            border-radius: 14px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(23, 39, 61, 0.08);
        }

        h1 {
            margin: 0 0 8px;
            font-size: 1.5rem;
        }

        p {
            margin: 0 0 18px;
            color: #4d6074;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.95rem;
            font-weight: 600;
        }

        input,
        select {
            width: 100%;
            box-sizing: border-box;
            height: 44px;
            padding: 0 12px;
            border-radius: 10px;
            border: 1px solid #b9c8dc;
            font-size: 0.95rem;
        }

        button {
            margin-top: 14px;
            height: 42px;
            border: 0;
            border-radius: 10px;
            padding: 0 18px;
            background: #0f5cc0;
            color: #ffffff;
            font-weight: 600;
            cursor: pointer;
        }

        button:disabled {
            opacity: 0.7;
            cursor: wait;
        }

        .response {
            margin-top: 16px;
            padding: 12px;
            border-radius: 10px;
            background: #f6f9fe;
            border: 1px solid #d8e2ef;
            white-space: pre-wrap;
            word-break: break-word;
            font-family: Consolas, "Courier New", monospace;
            font-size: 0.85rem;
        }
        fieldset {
            margin: 14px 0;
            border: 1px solid #d8e2ef;
            border-radius: 10px;
            padding: 10px 12px;
        }

        legend {
            padding: 0 6px;
            font-weight: 600;
            color: #2e4358;
        }

        .label-gap {
            margin-top: 10px;
        }

        .response-title {
            margin: 16px 0 6px;
            font-size: 0.9rem;
            font-weight: 700;
            color: #2e4358;
        }
    </style>
</head>
<body>
<main class="page">
    <section class="card">
        <h1>Create Stripe Connected Account</h1>
        <p>Submit the form and review the JSON response below.</p>

        <form
            id="create-connect-account-form"
            class="my-form"
            action="{{ path('api_pro_finance_create_stripe_connected_account') }}"
            method="post"
        >
            <label>
                <span>Business Name</span>
                <input class="inp-company-name" name="company_name" required>
            </label>
            <label class="label-gap">
                <span>Country</span>
                <select id="country" name="country" required>
                    <option value="">Select a country</option>
                </select>
            </label>
            <fieldset>
                <legend>Business Address</legend>
                <label>
                    <span>Street Address Line 1</span>
                    <input class="inp-company-street-address1" name="company_street_address1" required>
                </label>
                <label class="label-gap">
                    <span>City</span>
                    <input class="inp-company-city" name="company_city" required>
                </label>
                <label class="label-gap">
                    <span>State</span>
                    <input class="inp-company-state" name="company_state" required>
                </label>
                <label class="label-gap">
                    <span>Postal Code</span>
                    <input class="inp-company-zip" name="company_zip" required>
                </label>
            </fieldset>
            <label>
                <span>Representative First Name</span>
                <input class="inp-person-first-name" name="person_first_name" required>
            </label>
            <label class="label-gap">
                <span>Representative Last Name</span>
                <input class="inp-person-last-name" name="person_last_name" required>
            </label>
            <label class="label-gap">
                <span>Representative Email</span>
                <input id="email" class="inp-person-email" name="email" type="email" required placeholder="name@example.com">
            </label>
            <fieldset>
                <legend>Representative Address</legend>
                <label>
                    <span>Street Address Line 1</span>
                    <input class="inp-person-street-address1" name="person_street_address1" required>
                </label>
                <label class="label-gap">
                    <span>City</span>
                    <input class="inp-person-city" name="person_city" required>
                </label>
                <label class="label-gap">
                    <span>State</span>
                    <input class="inp-person-state" name="person_state" required>
                </label>
                <label class="label-gap">
                    <span>Postal Code</span>
                    <input class="inp-person-zip" name="person_zip" required>
                </label>
            </fieldset>
            <p>By clicking, you agree to <a href="#">our terms</a> and the <a href="https://stripe.com/connect-account/legal">Stripe Connected Account Agreement</a>.</p>
            <button id="submit-button" type="submit">Submit</button>
        </form>

        <h2 class="response-title">1) Token Creation</h2>
        <pre id="token-response-box" class="response">Token creation response will appear here.</pre>

        <h2 class="response-title">2) Account Creation</h2>
        <pre id="account-response-box" class="response">Account creation response will appear here.</pre>

        <h2 class="response-title">3) Account Link Creation</h2>
        <pre id="link-response-box" class="response">Account link creation response will appear here.</pre>
    </section>
</main>

