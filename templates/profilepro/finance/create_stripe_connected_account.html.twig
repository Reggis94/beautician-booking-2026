        countrySelect.append(option);
    }

    countrySelect.value = 'US';

    myForm.addEventListener('submit', handleForm);

    async function handleForm(event) {
        event.preventDefault();

        submitButton.disabled = true;
        tokenResponseBox.textContent = 'Waiting for backend token creation...';
        accountResponseBox.textContent = 'Waiting for account creation...';
        linkResponseBox.textContent = 'Waiting for account link creation...';

        try {
            const email = document.getElementById('email').value.trim();
            const companyName = document.querySelector('.inp-company-name').value.trim();
            const country = countrySelect.value;
            const tokenResponse = await fetch('https://api.stripe.com/v2/core/account_tokens', {
                method: 'POST',
                headers: {
                    Authorization: `Bearer ${stripePublishableKey}`,
                    'Stripe-Version': stripePreviewVersion,
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    contact_email: email,
                    display_name: companyName,
                    identity: {
                        {# attestations: {
                            terms_of_service: {
                                account: {
                                    shown_and_accepted: true,
                                },
                            },
                        }, #}
                        entity_type: 'company',
                        business_details: {
                            registered_name: companyName,
                        },
                    },
                }),
            });

            let tokenPayload;
            try {
                tokenPayload = await tokenResponse.json();
            } catch (error) {
                tokenPayload = { error: 'Response is not valid JSON.' };
            }

            tokenResponseBox.textContent = JSON.stringify({
                step: 'token_creation',
                status: tokenResponse.status,
                ok: tokenResponse.ok,
                account_token_id: tokenPayload.id ?? null,
                raw: tokenPayload,
            }, null, 2);

            if (!tokenResponse.ok || !tokenPayload.id) {
                throw new Error('Stripe account token creation failed.');
            }

            const response = await fetch(myForm.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    email,
                    country,
                    account_token: tokenPayload.id,
                }),
            });

            let payload;
            try {
                payload = await response.json();
            } catch (error) {
                payload = { error: 'Response is not valid JSON.' };
            }

            accountResponseBox.textContent = JSON.stringify({
                step: 'account_creation',
                status: response.status,
                ok: response.ok,
                account_id: payload.account_id ?? null,
                raw: payload,
            }, null, 2);

            if (!response.ok || !payload.account_id) {
                throw new Error('Backend account creation failed.');
            }

            const accountLinkResponse = await fetch('/api/create-connect-account-link', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    account_id: payload.account_id,
                }),
            });

            let accountLinkPayload;
            try {
                accountLinkPayload = await accountLinkResponse.json();
            } catch (error) {
                accountLinkPayload = { error: 'Response is not valid JSON.' };
            }

            linkResponseBox.textContent = JSON.stringify({
                step: 'account_link_creation',
                status: accountLinkResponse.status,
                ok: accountLinkResponse.ok,
                account_link_url: accountLinkPayload.account_link_url ?? null,
                account_link_expires_at: accountLinkPayload.account_link_expires_at ?? null,
                raw: accountLinkPayload,
            }, null, 2);
        } catch (error) {
            const errorPayload = JSON.stringify({
                error: error.message || 'Unknown network error.',
            }, null, 2);

            tokenResponseBox.textContent = errorPayload;
            accountResponseBox.textContent = errorPayload;
            linkResponseBox.textContent = errorPayload;
        } finally {
            submitButton.disabled = false;
        }
    }
