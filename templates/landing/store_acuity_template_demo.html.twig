{% extends 'front_pro/demo_home.html.twig' %}

{% block title %}Template {{ template_id }} demo - Glam4Style{% endblock %}

{% block demo_front_toolbar %}{% endblock %}

{% block demo_account_prompt %}{% endblock %}

{% block demo_bottom_actions %}
    <div class="store-demo-action-bar">
        <form method="post" action="{{ checkout_url }}">
            <input type="hidden" name="template_id" value="{{ template_id }}">
            <button type="submit" class="store-demo-action-bar__buy">Buy template</button>
        </form>
        <a class="store-demo-action-bar__back" href="{{ store_url }}">Back to store</a>
    </div>

    <style>
        .page-content {
            padding-bottom: 100px;
        }
        .store-demo-action-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            display: flex;
            gap: 12px;
            padding: 14px 24px;
            background: rgba(250, 246, 241, .96);
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(180, 150, 135, .22);
            z-index: 200;
        }
        .store-demo-action-bar form {
            display: flex;
            flex: 1;
        }
        .store-demo-action-bar__buy {
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #FAF6F1;
            background: #1C1916;
            border: none;
            padding: 14px 18px;
            cursor: pointer;
            width: 100%;
            text-align: center;
        }
        .store-demo-action-bar__buy:hover {
            background: #B8765F;
        }
        .store-demo-action-bar__back {
            flex: 1;
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #6B5F58;
            background: none;
            border: 1px solid rgba(180, 150, 135, .22);
            padding: 13px 18px;
            text-decoration: none;
            text-align: center;
        }
        .store-demo-action-bar__back:hover {
            border-color: #D4998A;
            color: #B8765F;
        }
        @media (max-width: 480px) {
            .store-demo-action-bar {
                padding: 12px 16px;
            }
        }
    </style>
{% endblock %}
