{#
  templates/checkout/index.html.twig

  Variables expected:
    - etsy_url:    string  (Etsy listing URL — set when available)
    - landing_url: string  (home page route)
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Get started — Glam4Style</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --cream:       #FAF6F1;
      --blush:       #F2E0D6;
      --rose:        #D4998A;
      --rose-deep:   #B8765F;
      --charcoal:    #1C1916;
      --warm-grey:   #6B5F58;
      --mid:         #A89890;
      --soft-border: rgba(180,150,135,0.22);
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans:  'DM Sans', system-ui, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--cream);
      color: var(--charcoal);
      font-family: var(--sans);
      font-weight: 300;
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ── NAV ── */
    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 32px;
      border-bottom: 1px solid var(--soft-border);
      background: rgba(250,246,241,0.95);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .logo {
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--charcoal);
      letter-spacing: .04em;
      text-decoration: none;
    }
    .logo span { color: var(--rose-deep); }
    .nav-back {
      font-size: 12px;
      color: var(--mid);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color .18s;
    }
    .nav-back:hover { color: var(--rose-deep); }

    /* ── HERO ── */
    .hero {
      background: var(--charcoal);
      padding: 72px 32px 64px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 700px; height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(212,153,138,0.09) 0%, transparent 65%);
      pointer-events: none;
    }
    .hero-eyebrow {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--rose);
      margin-bottom: 20px;
      position: relative;
    }
    .hero h1 {
      font-family: var(--serif);
      font-size: clamp(38px, 7vw, 68px);
      font-weight: 300;
      line-height: 1.08;
      color: var(--cream);
      margin-bottom: 20px;
      position: relative;
    }
    .hero h1 em { font-style: italic; color: var(--rose); }
    .hero-sub {
      font-size: 15px;
      color: rgba(255,255,255,.42);
      max-width: 460px;
      margin: 0 auto 44px;
      line-height: 1.75;
      position: relative;
    }

    /* ── THE BIG VISUAL COMPARISON ── */
    .months-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      margin: 0 auto 44px;
      max-width: 560px;
      position: relative;
    }

    .month-block {
      flex: 1;
      padding: 20px 0;
      text-align: center;
      border: 1px solid rgba(255,255,255,.08);
    }
    .month-block.acuity {
      background: rgba(255,255,255,.04);
      border-right: none;
    }
    .month-block.g4s {
      background: rgba(212,153,138,.12);
      border-color: rgba(212,153,138,.3);
    }

    .month-block-label {
      font-size: 9px;
      font-weight: 500;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: rgba(255,255,255,.3);
      margin-bottom: 8px;
    }
    .month-block.g4s .month-block-label { color: var(--rose); }

    .month-block-price {
      font-family: var(--serif);
      font-size: clamp(32px, 6vw, 52px);
      font-weight: 300;
      line-height: 1;
      color: rgba(255,255,255,.25);
      margin-bottom: 4px;
    }
    .month-block.g4s .month-block-price { color: var(--cream); }

    .month-block-period {
      font-size: 11px;
      color: rgba(255,255,255,.2);
    }
    .month-block.g4s .month-block-period { color: rgba(255,255,255,.5); }

    .months-vs {
      width: 40px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      z-index: 1;
    }
    .months-vs-line {
      width: 1px;
      height: 20px;
      background: rgba(255,255,255,.1);
    }
    .months-vs-text {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: .1em;
      color: rgba(255,255,255,.25);
      text-transform: uppercase;
    }

    /* The hero statement */
    .hero-statement {
      font-family: var(--serif);
      font-size: clamp(15px, 2.5vw, 19px);
      font-weight: 300;
      color: rgba(255,255,255,.55);
      max-width: 480px;
      margin: 0 auto 40px;
      line-height: 1.6;
      position: relative;
    }
    .hero-statement strong {
      color: var(--cream);
      font-weight: 400;
    }
    .hero-statement em {
      font-style: italic;
      color: var(--rose);
    }

    .btn-etsy {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--cream);
      background: var(--rose-deep);
      border: none;
      padding: 18px 44px;
      cursor: pointer;
      text-decoration: none;
      transition: background .18s, transform .12s;
      position: relative;
    }
    .btn-etsy:hover { background: var(--rose); transform: translateY(-2px); }
    .btn-etsy svg { flex-shrink: 0; }

    .hero-note {
      font-size: 12px;
      color: rgba(255,255,255,.22);
      margin-top: 16px;
      position: relative;
      line-height: 1.7;
    }

    /* ── CALLOUT STRIP ── */
    .callout-strip {
      background: var(--rose-deep);
      padding: 22px 32px;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 24px;
      flex-wrap: wrap;
    }
    .callout-strip-text {
      font-family: var(--serif);
      font-size: clamp(18px, 3vw, 26px);
      font-weight: 300;
      color: var(--cream);
      line-height: 1.3;
    }
    .callout-strip-text em { font-style: italic; }
    .callout-strip-divider {
      width: 1px; height: 32px;
      background: rgba(255,255,255,.25);
      flex-shrink: 0;
    }
    .callout-strip-sub {
      font-size: 12px;
      color: rgba(255,255,255,.65);
      letter-spacing: .04em;
      white-space: nowrap;
    }

    /* ── HOW IT WORKS ── */
    .how {
      padding: 72px 32px;
      max-width: 900px;
      margin: 0 auto;
    }
    .section-eyebrow {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--rose-deep);
      margin-bottom: 12px;
    }
    .section-h2 {
      font-family: var(--serif);
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 300;
      line-height: 1.2;
      margin-bottom: 52px;
    }
    .section-h2 em { font-style: italic; color: var(--rose-deep); }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border: 1px solid var(--soft-border);
    }
    .step {
      padding: 36px 28px;
      border-right: 1px solid var(--soft-border);
      position: relative;
      overflow: hidden;
    }
    .step:last-child { border-right: none; }
    .step::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 0; height: 2px;
      background: var(--rose);
      transition: width .5s ease;
    }
    .step:hover::after { width: 100%; }

    .step-num {
      font-family: var(--serif);
      font-size: 56px;
      font-weight: 300;
      color: #CCBFB8;
      line-height: 1;
      margin-bottom: 16px;
      letter-spacing: -.02em;
    }
    .step-title {
      font-family: var(--serif);
      font-size: 21px;
      font-weight: 400;
      margin-bottom: 10px;
      line-height: 1.2;
    }
    .step-body {
      font-size: 13px;
      color: var(--warm-grey);
      line-height: 1.7;
    }
    .step-body strong { color: var(--charcoal); font-weight: 500; }

    .step-arrow {
      position: absolute;
      right: -13px;
      top: 44px;
      width: 26px; height: 26px;
      background: var(--cream);
      border: 1px solid var(--soft-border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--mid);
      font-size: 12px;
      z-index: 2;
    }
    .step:last-child .step-arrow { display: none; }

    /* ── COMPARISON ── */
    .comparison {
      background: var(--charcoal);
      padding: 72px 32px;
    }
    .comparison-inner {
      max-width: 900px;
      margin: 0 auto;
    }
    .comparison .section-eyebrow { color: var(--rose); }
    .comparison .section-h2 { color: var(--cream); }
    .comparison .section-h2 em { color: var(--rose); }

    /* the big visual ratio */
    .ratio-visual {
      display: flex;
      align-items: stretch;
      gap: 0;
      margin-bottom: 48px;
      border: 1px solid rgba(255,255,255,.08);
      overflow: hidden;
    }
    .ratio-acuity {
      flex: 2;
      background: rgba(255,255,255,.04);
      padding: 28px 24px;
      border-right: 1px solid rgba(255,255,255,.08);
      position: relative;
    }
    .ratio-g4s {
      flex: 10;
      background: rgba(212,153,138,.1);
      padding: 28px 24px;
      border-left: 1px solid rgba(212,153,138,.2);
      position: relative;
    }
    .ratio-tag {
      font-size: 9px;
      font-weight: 500;
      letter-spacing: .16em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .ratio-acuity .ratio-tag { color: rgba(255,255,255,.25); }
    .ratio-g4s .ratio-tag { color: var(--rose); }
    .ratio-amount {
      font-family: var(--serif);
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 300;
      line-height: 1;
      margin-bottom: 4px;
    }
    .ratio-acuity .ratio-amount { color: rgba(255,255,255,.2); }
    .ratio-g4s .ratio-amount { color: var(--cream); }
    .ratio-desc {
      font-size: 11px;
      line-height: 1.5;
    }
    .ratio-acuity .ratio-desc { color: rgba(255,255,255,.2); }
    .ratio-g4s .ratio-desc { color: rgba(255,255,255,.45); }
    .ratio-label {
      position: absolute;
      bottom: 10px; right: 14px;
      font-family: var(--serif);
      font-size: 11px;
      font-style: italic;
      color: var(--rose);
      opacity: .7;
    }

    .comparison-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .comp-card {
      border: 1px solid rgba(255,255,255,.07);
      padding: 32px 28px;
      position: relative;
      background: rgba(255,255,255,.03);
    }
    .comp-card.winner {
      border-color: var(--rose);
      background: rgba(212,153,138,.07);
    }
    .comp-card-tag {
      position: absolute;
      top: -1px; left: 20px;
      font-size: 9px;
      font-weight: 500;
      letter-spacing: .14em;
      text-transform: uppercase;
      padding: 4px 12px;
      background: var(--rose-deep);
      color: var(--cream);
    }
    .comp-name {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: rgba(255,255,255,.25);
      margin-bottom: 6px;
      margin-top: 8px;
    }
    .comp-card.winner .comp-name { color: var(--rose); }
    .comp-price {
      font-family: var(--serif);
      font-size: clamp(40px, 6vw, 62px);
      font-weight: 300;
      line-height: 1;
      color: rgba(255,255,255,.15);
      margin-bottom: 2px;
      text-decoration: line-through;
      text-decoration-color: rgba(212,153,138,.4);
    }
    .comp-card.winner .comp-price {
      color: var(--cream);
      text-decoration: none;
    }
    .comp-period {
      font-size: 12px;
      color: rgba(255,255,255,.2);
      margin-bottom: 24px;
    }
    .comp-card.winner .comp-period { color: rgba(255,255,255,.4); }

    /* inline months badge on G4S card */
    .comp-months-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--rose-deep);
      color: var(--cream);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .06em;
      padding: 5px 12px;
      margin-bottom: 20px;
    }

    .comp-rows { display: flex; flex-direction: column; }
    .comp-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 9px 0;
      border-bottom: 1px solid rgba(255,255,255,.06);
      font-size: 13px;
      color: rgba(255,255,255,.22);
      line-height: 1.4;
    }
    .comp-card.winner .comp-row { color: rgba(255,255,255,.6); border-color: rgba(255,255,255,.08); }
    .comp-row:last-child { border-bottom: none; }
    .comp-icon { flex-shrink: 0; margin-top: 1px; }

    .savings-banner {
      background: var(--rose-deep);
      color: var(--cream);
      padding: 22px 28px;
      text-align: center;
      font-family: var(--serif);
      font-size: clamp(18px, 3vw, 26px);
      font-weight: 300;
      margin-top: 12px;
      line-height: 1.4;
    }
    .savings-banner em { font-style: italic; }
    .savings-banner small {
      display: block;
      font-family: var(--sans);
      font-size: 12px;
      color: rgba(255,255,255,.55);
      margin-top: 6px;
      font-weight: 300;
      letter-spacing: .02em;
    }

    /* ── FINAL CTA ── */
    .final {
      padding: 80px 32px;
      text-align: center;
      max-width: 600px;
      margin: 0 auto;
    }
    .final-h2 {
      font-family: var(--serif);
      font-size: clamp(32px, 5vw, 52px);
      font-weight: 300;
      line-height: 1.1;
      margin-bottom: 16px;
    }
    .final-h2 em { font-style: italic; color: var(--rose-deep); }
    .final-sub {
      font-size: 14px;
      color: var(--warm-grey);
      margin-bottom: 32px;
      line-height: 1.75;
    }
    .final-note {
      font-size: 12px;
      color: var(--mid);
      margin-top: 16px;
      line-height: 1.7;
    }

    /* ── FOOTER ── */
    footer {
      padding: 20px 32px;
      border-top: 1px solid var(--soft-border);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      color: var(--mid);
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 640px) {
      nav { padding: 16px 20px; }
      .hero { padding: 52px 20px 48px; }
      .months-visual { flex-direction: column; max-width: 280px; }
      .month-block.acuity { border-right: 1px solid rgba(255,255,255,.08); border-bottom: none; }
      .months-vs { flex-direction: row; width: auto; height: 32px; gap: 8px; }
      .months-vs-line { width: 24px; height: 1px; }
      .callout-strip { flex-direction: column; gap: 10px; padding: 20px; }
      .callout-strip-divider { display: none; }
      .how { padding: 52px 20px; }
      .steps { grid-template-columns: 1fr; }
      .step { border-right: none; border-bottom: 1px solid var(--soft-border); }
      .step:last-child { border-bottom: none; }
      .step-arrow { display: none; }
      .comparison { padding: 52px 20px; }
      .ratio-visual { flex-direction: column; }
      .ratio-acuity { border-right: none; border-bottom: 1px solid rgba(255,255,255,.08); flex: none; }
      .ratio-g4s { flex: none; }
      .comparison-grid { grid-template-columns: 1fr; }
      .comp-card.muted { display: none; }
      .final { padding: 52px 20px; }
      footer { flex-direction: column; text-align: center; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition: none !important; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="{{ landing_url }}" class="logo">Glam<span>4Style</span></a>
  <a href="{{ landing_url }}" class="nav-back">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M10 3L5 8l5 5"/>
    </svg>
    Back to home
  </a>
</nav>

<!-- HERO -->
<div class="hero">
  <p class="hero-eyebrow">Yearly subscription · No surprises</p>
  <h1>2 months of Acuity.<br><em>Is a full year with us.</em></h1>
  <p class="hero-sub">
    Acuity charges $20 every month. Two months of that buys you
    an entire year of Glam4Style — with free setup included.
  </p>

  <!-- Visual month comparison -->
  <div class="months-visual">
    <div class="month-block acuity">
      <div class="month-block-label">Acuity — 2 months</div>
      <div class="month-block-price">$40</div>
      <div class="month-block-period">then pay again</div>
    </div>
    <div class="months-vs">
      <div class="months-vs-line"></div>
      <div class="months-vs-text">vs</div>
      <div class="months-vs-line"></div>
    </div>
    <div class="month-block g4s">
      <div class="month-block-label">Glam4Style — full year</div>
      <div class="month-block-price">$40.68</div>
      <div class="month-block-period">12 months included</div>
    </div>
  </div>

  <p class="hero-statement">
    <strong>Same money.</strong> With Acuity, it runs out in January.
    With Glam4Style, it covers you <em>all year long</em> —
    and we set the whole thing up for free.
  </p>

  <a href="{{ etsy_url ?? '#' }}" class="btn-etsy" {% if not etsy_url %}aria-disabled="true"{% endif %}>
    Purchase now
  </a>

  <p class="hero-note">
    One payment · 12 months included · We set everything up free<br>
    Live within 24 hours · Secure checkout via Etsy
  </p>
</div>

<!-- CALLOUT STRIP -->
<div class="callout-strip">
  <div class="callout-strip-text">2 months of Acuity = <em>1 full year</em> of Glam4Style</div>
  <div class="callout-strip-divider"></div>
  <div class="callout-strip-sub">$40 vs $240 per year — you do the maths</div>
</div>

<!-- HOW IT WORKS -->
<div class="how">
  <p class="section-eyebrow">How it works</p>
  <h2 class="section-h2">From payment to fully live<br>in <em>three steps.</em></h2>

  <div class="steps">
    <div class="step">
      <div class="step-num">01</div>
      <p class="step-title">Pay once on Etsy</p>
      <p class="step-body">
        Click the button above and complete your purchase on Etsy.
        <strong>$40.68 for the full year</strong> — one payment,
        no monthly billing, no auto-renewal surprises.
      </p>
      <div class="step-arrow">→</div>
    </div>

    <div class="step">
      <div class="step-num">02</div>
      <p class="step-title">Fill in one short form</p>
      <p class="step-body">
        After payment, Etsy sends you a link to a Google Form.
        Tell us your <strong>services, opening hours, and template link.</strong>
        Five minutes, that's it.
      </p>
      <div class="step-arrow">→</div>
    </div>

    <div class="step">
      <div class="step-num">03</div>
      <p class="step-title">We build it. You go live.</p>
      <p class="step-body">
        Within <strong>24 hours</strong> your booking page is live,
        your template is connected, and clients can book you.
        You don't touch a single setting.
      </p>
    </div>
  </div>
</div>

<!-- COMPARISON -->
<div class="comparison">
  <div class="comparison-inner">
    <p class="section-eyebrow">The honest numbers</p>
    <h2 class="section-h2">Acuity costs <em>6× more</em><br>for a tool not built for you.</h2>

    <!-- Ratio bar -->
    <div class="ratio-visual">
      <div class="ratio-acuity">
        <div class="ratio-tag">Acuity — 2 months</div>
        <div class="ratio-amount">$40</div>
        <div class="ratio-desc">Gone in 60 days.<br>Then $20 again. And again.</div>
      </div>
      <div class="ratio-g4s">
        <div class="ratio-tag">Glam4Style — full year</div>
        <div class="ratio-amount">$40.68</div>
        <div class="ratio-desc">
          12 months of booking software.<br>
          Free setup. Free template integration. Done in 24h.
        </div>
        <div class="ratio-label">Same price. 6× longer.</div>
      </div>
    </div>

    <div class="comparison-grid">
      <div class="comp-card">
        <p class="comp-name">Acuity Scheduling</p>
        <div class="comp-price">$240</div>
        <p class="comp-period">per year · $20 every month</p>
        <div class="comp-rows">
          <div class="comp-row"><span class="comp-icon">✗</span> Built for every business type</div>
          <div class="comp-row"><span class="comp-icon">✗</span> You set it up yourself</div>
          <div class="comp-row"><span class="comp-icon">✗</span> Template integration not included</div>
          <div class="comp-row"><span class="comp-icon">✗</span> Features you will never use</div>
