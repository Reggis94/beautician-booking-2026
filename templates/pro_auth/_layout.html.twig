{#
  templates/pro_auth/_layout.html.twig

  Shared Glam4Style layout for the beautician authentication pages: brand panel on the left, content on the right.

  Blocks:
    - lang:    page language (default "en").
    - title:   page title prefix.
    - brand:   brand panel text (eyebrow, headline, sub-line).
    - content: right panel content.
    - scripts: page script.
#}
<!DOCTYPE html>
<html lang="{% block lang %}en{% endblock %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <meta name="referrer" content="no-referrer">
  <title>{% block title %}Sign in{% endblock %} — Glam4Style</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --cream:       #FAF6F1;
      --blush:       #F2E0D6;
      --rose:        #D4998A;
      --rose-deep:   #B8765F;
      --charcoal:    #1C1916;
      --warm-grey:   #6B5F58;
      --mid:         #A89890;
      --soft-border: rgba(180,150,135,0.22);
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans:  'DM Sans', system-ui, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    [hidden] { display: none !important; }

    body {
      background: var(--cream);
      color: var(--charcoal);
      font-family: var(--sans);
      font-weight: 300;
      line-height: 1.6;
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    /* ── LEFT PANEL ── */
    .left {
      background: var(--charcoal);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 48px 56px;
      position: relative;
      overflow: hidden;
    }

    /* large decorative letterform */
    .left::before {
      content: 'G';
      font-family: var(--serif);
      font-size: 480px;
      font-weight: 300;
      font-style: italic;
      color: rgba(255,255,255,0.04);
      position: absolute;
      bottom: -80px;
      right: -40px;
      line-height: 1;
      pointer-events: none;
      user-select: none;
    }

    .left-logo {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--cream);
      text-decoration: none;
    }
    .left-logo span { color: var(--rose); }

    .left-body { position: relative; z-index: 1; }

    .left-eyebrow {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--rose);
      margin-bottom: 18px;
    }

    .left-headline {
      font-family: var(--serif);
      font-size: clamp(36px, 4vw, 56px);
      font-weight: 300;
      line-height: 1.1;
      color: var(--cream);
      margin-bottom: 24px;
    }
    .left-headline em { font-style: italic; color: var(--rose); }

    .left-sub {
      font-size: 14px;
      color: rgba(255,255,255,0.4);
      max-width: 320px;
      line-height: 1.7;
    }

    .left-footer {
      font-size: 11px;
      color: rgba(255,255,255,0.2);
      letter-spacing: 0.04em;
      position: relative;
      z-index: 1;
    }

    /* ── RIGHT PANEL ── */
    .right {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 64px 72px;
    }

    .panel {
      width: 100%;
      max-width: 360px;
    }
    .panel.centered { text-align: center; }

    .form-eyebrow {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--rose-deep);
      margin-bottom: 10px;
    }

    .form-title {
      font-family: var(--serif);
      font-size: clamp(28px, 3.5vw, 42px);
      font-weight: 300;
      line-height: 1.15;
      margin-bottom: 10px;
    }
    .form-title em { font-style: italic; color: var(--rose-deep); }

    .form-desc {
      font-size: 14px;
      color: var(--warm-grey);
      line-height: 1.65;
      margin-bottom: 36px;
    }

    /* banners */
    .banner {
      padding: 12px 16px;
      font-size: 13px;
      margin-bottom: 24px;
      line-height: 1.5;
      text-align: left;
    }
    .banner-error {
      background: #fff5f5;
      border-left: 2px solid #c0392b;
      color: #7a1f1f;
    }
    .banner-info {
      background: var(--blush);
      border-left: 2px solid var(--rose-deep);
      color: var(--warm-grey);
    }

    .form-field { margin-bottom: 20px; }

    .form-label {
      display: block;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--warm-grey);
      margin-bottom: 8px;
    }

    .form-input {
      width: 100%;
      border: 1px solid var(--soft-border);
      background: var(--blush);
      padding: 14px 16px;
      font-family: var(--sans);
      font-size: 15px;
      color: var(--charcoal);
      outline: none;
      transition: border-color 0.18s, background 0.18s;
      -webkit-appearance: none;
    }
    .form-input::placeholder { color: var(--mid); }
    .form-input:focus { border-color: var(--rose); background: #fff; }
    .form-input.invalid { border-color: #c0392b; }

    .field-error {
      font-size: 12px;
      color: #c0392b;
      margin-top: 6px;
    }

    .btn-primary {
      display: block;
      width: 100%;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-align: center;
      text-decoration: none;
      color: var(--cream);
      background: var(--charcoal);
      border: none;
      padding: 16px 28px;
      cursor: pointer;
      transition: background 0.18s, transform 0.12s, opacity 0.18s;
      margin-top: 4px;
    }
    .btn-primary:hover  { background: var(--rose-deep); transform: translateY(-1px); }
    .btn-primary:active { transform: translateY(0); }
    .btn-primary:disabled,
    .btn-primary:disabled:hover {
      background: var(--charcoal);
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
    }

    .form-note {
      font-size: 12px;
      color: var(--mid);
      text-align: center;
      margin-top: 18px;
      line-height: 1.6;
    }

    /* ── STATUS STATES ── */
    .status-mark {
      font-family: var(--serif);
      font-size: 48px;
      font-weight: 300;
      color: var(--rose);
      display: block;
      margin-bottom: 20px;
      line-height: 1;
    }

    .status-title {
      font-family: var(--serif);
      font-size: clamp(26px, 3vw, 38px);
      font-weight: 300;
      line-height: 1.2;
      margin-bottom: 14px;
    }
    .status-title em { font-style: italic; color: var(--rose-deep); }

    .status-desc {
      font-size: 14px;
      color: var(--warm-grey);
      line-height: 1.7;
      margin-bottom: 32px;
    }
    .status-email {
      font-weight: 500;
      color: var(--charcoal);
      word-break: break-all;
    }

    .divider {
      width: 40px;
      height: 1px;
      background: var(--soft-border);
      margin: 24px auto;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 780px) {
      /* minmax(0, 1fr): without it, the column grows to its widest content and overflows the screen. */
      body { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
      .left {
        justify-content: flex-start;
        gap: 24px;
        padding: 28px 24px 32px;
        min-height: auto;
      }
      .left::before { font-size: 260px; bottom: -40px; right: -20px; }
      .left-headline { font-size: 32px; margin-bottom: 16px; overflow-wrap: break-word; }
      .left-sub { font-size: 13px; }
      .left-footer { display: none; }
      .hide-on-mobile { display: none; }
      .right { justify-content: flex-start; padding: 40px 24px 56px; }
      .form-desc { margin-bottom: 28px; }
      /* 16px keeps iOS Safari from zooming into the page when the field gets focus. */
      .form-input { font-size: 16px; }
      .btn-primary { padding: 16px 18px; }
    }

    @media (max-width: 360px) {
      .left { padding: 24px 16px 28px; }
      .left-headline { font-size: 28px; }
      .right { padding: 32px 16px 48px; }
      .btn-primary { letter-spacing: 0.08em; }
    }
  </style>
</head>
<body>

{# ── LEFT ── #}
<div class="left">
  <a href="{{ path('glam4style_landing_page') }}" class="left-logo">Glam<span>4Style</span></a>

  <div class="left-body">
    {% block brand %}
    <p class="left-eyebrow">Booking for beauty professionals</p>
    <p class="left-headline">Your clients,<br><em>beautifully</em><br>organised.</p>
    <p class="left-sub">Manage your appointments and services from one simple place.</p>
    {% endblock %}
  </div>

  <p class="left-footer">© {{ "now"|date("Y") }} Glam4Style</p>
</div>

{# ── RIGHT ── #}
<main class="right">
  {% block content %}{% endblock %}
</main>

{% block scripts %}{% endblock %}
</body>
</html>
