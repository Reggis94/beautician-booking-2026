{#
  templates/pro_admin/dashboard.html.twig
  Variables expected from controller:
    - upcomingAppointments: Appointment[]  (date >= today, ordered ASC)
    - pastAppointments:     Appointment[]  (date < today,  ordered DESC)
    - services:             Service[]
    - activeTab:            string  ('upcoming'|'past'|'services'|'opening_hours')  default 'upcoming'
  Each Appointment has:
    - id, clientName, clientPhone, serviceName, date (DateTime), durationMinutes
  Each Service has:
    - id, name, description, durationMinutes, price
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Glam4Style</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    /* ── TOKENS ── */
    :root {
      --cream:       #FAF6F1;
      --blush:       #F2E0D6;
      --rose:        #D4998A;
      --rose-deep:   #B8765F;
      --charcoal:    #1C1916;
      --warm-grey:   #6B5F58;
      --mid:         #A89890;
      --soft-border: rgba(180,150,135,0.22);
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans:  'DM Sans', system-ui, sans-serif;
      --sidebar-w: 220px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--cream);
      color: var(--charcoal);
      font-family: var(--sans);
      font-weight: 300;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
    }

    /* ── SIDEBAR ── */
    .sidebar {
      width: var(--sidebar-w);
      flex-shrink: 0;
      background: var(--charcoal);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 36px 0 32px;
      position: fixed;
      top: 0; left: 0; bottom: 0;
      z-index: 50;
    }

    .sidebar-logo {
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--cream);
      text-decoration: none;
      padding: 0 28px 36px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      display: block;
    }
    .sidebar-logo span { color: var(--rose); }

    .sidebar-nav {
      flex: 1;
      padding: 28px 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .sidebar-nav a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 28px;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.03em;
      color: rgba(255,255,255,0.45);
      text-decoration: none;
      transition: color 0.18s, background 0.18s;
      position: relative;
    }
    .sidebar-nav a:hover {
      color: var(--cream);
      background: rgba(255,255,255,0.05);
    }
    .sidebar-nav a.active {
      color: var(--cream);
    }
    .sidebar-nav a.active::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: var(--rose);
    }

    .nav-icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      opacity: 0.6;
    }
    .sidebar-nav a.active .nav-icon,
    .sidebar-nav a:hover .nav-icon { opacity: 1; }

    .sidebar-footer {
      padding: 24px 28px 0;
      border-top: 1px solid rgba(255,255,255,0.07);
    }

    .mobile-menu-toggle {
      display: none;
    }

    .logout-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      text-decoration: none;
      transition: color 0.18s;
    }
    .logout-btn:hover { color: var(--rose); }

    /* ── MAIN ── */
    .main {
      margin-left: var(--sidebar-w);
      flex: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .main-header {
      padding: 40px 52px 0;
      border-bottom: 1px solid var(--soft-border);
      padding-bottom: 0;
    }

    .page-eyebrow {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--rose-deep);
      margin-bottom: 6px;
    }

    .page-title {
      font-family: var(--serif);
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 300;
      line-height: 1.15;
      padding-bottom: 28px;
    }
    .page-title em { font-style: italic; color: var(--rose-deep); }

    .main-content {
      padding: 40px 52px 60px;
      flex: 1;
    }

    /* ── APPOINTMENT LIST ── */
    .day-group { margin-bottom: 40px; }

    .day-label {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--mid);
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--soft-border);
    }

    .appt-row {
      display: grid;
      grid-template-columns: 80px 1fr auto auto;
      align-items: center;
      gap: 20px;
      padding: 16px 0;
      border-bottom: 1px solid var(--soft-border);
      transition: opacity 0.35s ease;
    }
    .appt-row:first-of-type { border-top: none; }
    .appt-row.removing { opacity: 0; pointer-events: none; }

    .appt-time {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 300;
      color: var(--charcoal);
      white-space: nowrap;
    }

    .appt-info {}
    .appt-client {
      font-size: 15px;
      font-weight: 400;
      color: var(--charcoal);
      margin-bottom: 2px;
    }
    .appt-meta {
      font-size: 12px;
      color: var(--mid);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .appt-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--rose);
      display: inline-block;
      flex-shrink: 0;
    }

    .appt-duration-pill {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.06em;
      color: var(--warm-grey);
      background: var(--blush);
      border: 1px solid var(--soft-border);
      padding: 4px 10px;
      white-space: nowrap;
      align-self: center;
    }

    .appt-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .icon-btn {
      background: none;
      border: 1px solid var(--soft-border);
      width: 34px; height: 34px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      color: var(--mid);
      transition: border-color 0.18s, color 0.18s, background 0.18s;
    }
    .icon-btn:hover { border-color: var(--rose); color: var(--rose-deep); background: var(--blush); }
    .icon-btn.danger:hover { border-color: #c0392b; color: #c0392b; background: #fff5f5; }

    /* ── PAST APPOINTMENTS ── */
    .appt-row.past .appt-time { color: var(--mid); }
    .appt-row.past .appt-client { color: var(--warm-grey); }
    .appt-row.past .appt-dot { background: var(--soft-border); }

    /* ── SERVICES LIST ── */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1px;
      background: var(--soft-border);
      border: 1px solid var(--soft-border);
    }

    .service-card {
      background: var(--cream);
      padding: 28px 32px;
      transition: background 0.18s;
    }
    .service-card:hover { background: var(--blush); }

    .service-name {
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 400;
      margin-bottom: 6px;
    }
    .service-meta {
      font-size: 12px;
      color: var(--mid);
      display: flex;
      gap: 14px;
    }
    .service-description {
      color: var(--warm-grey);
      font-size: 13px;
      line-height: 1.55;
      margin-top: 10px;
    }
    .service-price {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 300;
      color: var(--charcoal);
      margin-top: 14px;
    }

    /* ── EMPTY STATES ── */
    .empty {
      padding: 64px 0;
      text-align: center;
      color: var(--mid);
    }
    .empty-mark {
      font-family: var(--serif);
      font-size: 48px;
      font-weight: 300;
      color: var(--blush);
      display: block;
      margin-bottom: 12px;
    }
    .empty p { font-size: 14px; }

    /* ── EDIT MODAL ── */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(28,25,22,0.55);
      backdrop-filter: blur(6px);
      z-index: 200;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      opacity: 0; pointer-events: none;
      transition: opacity 0.28s ease;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }

    .modal {
      background: var(--cream);
      width: 100%; max-width: 440px;
      padding: 52px 44px;
      position: relative;
      transform: translateY(18px);
      transition: transform 0.32s ease;
    }
    .modal-overlay.open .modal { transform: translateY(0); }

    .modal-close {
      position: absolute; top: 18px; right: 22px;
      background: none; border: none; font-size: 22px;
      color: var(--mid); cursor: pointer;
      transition: color 0.18s;
    }
    .modal-close:hover { color: var(--charcoal); }

    .modal-eyebrow {
      font-size: 10px; font-weight: 500;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--rose-deep); margin-bottom: 10px;
    }
    .modal-title {
      font-family: var(--serif);
      font-size: 32px; font-weight: 300; line-height: 1.2;
      margin-bottom: 24px;
    }

    /* Contact notice banner */
    .notice-banner {
      background: var(--blush);
      border-left: 2px solid var(--rose-deep);
      padding: 12px 16px;
      font-size: 13px;
      color: var(--warm-grey);
      line-height: 1.5;
      margin-bottom: 28px;
    }
    .notice-banner strong { color: var(--rose-deep); font-weight: 500; }

    .form-field { margin-bottom: 18px; }

    .form-label {
      display: block;
      font-size: 10px; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--warm-grey);
      margin-bottom: 8px;
    }

    .form-input {
      width: 100%;
      border: 1px solid var(--soft-border);
      background: var(--blush);
      padding: 12px 16px;
      font-family: var(--sans);
      font-size: 14px; color: var(--charcoal);
      outline: none;
      transition: border-color 0.18s;
      appearance: none;
    }
    .form-input:focus { border-color: var(--rose); }

    .modal-actions {
      display: flex; gap: 12px; margin-top: 28px;
    }

    .btn-primary {
      font-family: var(--sans);
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--cream); background: var(--charcoal);
      border: none; padding: 13px 28px;
      cursor: pointer;
      transition: background 0.18s, transform 0.12s;
    }
    .btn-primary:hover { background: var(--rose-deep); transform: translateY(-1px); }

    .btn-ghost {
      font-family: var(--sans);
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--warm-grey); background: none;
      border: 1px solid var(--soft-border);
      padding: 13px 28px;
      cursor: pointer;
      transition: border-color 0.18s, color 0.18s;
    }
    .btn-ghost:hover { border-color: var(--rose); color: var(--rose-deep); }

    /* ── CONFIRM DELETE MODAL ── */
    #deleteModal .modal { max-width: 380px; padding: 44px 40px; }
    .delete-warning {
      font-size: 13px; color: var(--warm-grey);
      margin-bottom: 28px; line-height: 1.6;
    }
    .btn-danger {
      font-family: var(--sans);
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: #fff; background: #b83232;
      border: none; padding: 13px 28px;
      cursor: pointer;
      transition: background 0.18s;
    }
    .btn-danger:hover { background: #8c1f1f; }

    /* ── MOBILE ── */
    @media (max-width: 768px) {
      :root { --sidebar-w: 0px; }
      body {
        display: block;
        padding-top: 58px;
      }

      .sidebar {
        bottom: auto;
        height: auto;
        width: 100%;
        min-height: auto;
        flex-direction: column;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding: 0;
        z-index: 100;
        box-shadow: 0 8px 24px rgba(28,25,22,0.12);
      }

      .sidebar-header {
        align-items: center;
        display: flex;
        min-height: 58px;
        width: 100%;
      }

      .mobile-menu-toggle {
        align-items: center;
        background: none;
        border: 0;
        border-right: 1px solid rgba(255,255,255,0.07);
        color: var(--cream);
        cursor: pointer;
        display: flex;
        height: 58px;
        justify-content: center;
        padding: 0;
        width: 58px;
      }

      .mobile-menu-toggle svg {
        height: 22px;
        width: 22px;
      }

      .sidebar-logo {
        border-bottom: none;
        flex: 1;
        padding: 16px 20px;
      }

      .sidebar-nav,
      .sidebar-footer {
        display: none;
        width: 100%;
      }

      .sidebar.is-open .sidebar-nav,
      .sidebar.is-open .sidebar-footer {
        display: flex;
      }

      .sidebar-nav {
        border-top: 1px solid rgba(255,255,255,0.07);
        flex: none;
        flex-direction: column;
        gap: 0;
        padding: 8px 0;
      }

      .sidebar-nav a {
        padding: 14px 20px;
        white-space: nowrap;
      }

      .sidebar-nav a.active::before {
        bottom: 0;
        height: auto;
        left: 0;
        right: auto;
        top: 0;
        width: 2px;
      }

      .sidebar-footer {
        border-top: 1px solid rgba(255,255,255,0.07);
        padding: 16px 20px 18px;
      }

      .main { margin-left: 0; }
      .main-header, .main-content { padding-left: 20px; padding-right: 20px; }
      .appt-row { grid-template-columns: 60px 1fr auto; }
      .appt-duration-pill { display: none; }
      .modal { padding: 36px 24px; }
    }
  </style>
</head>
<body>

{# ── SIDEBAR ── #}
<aside class="sidebar" role="navigation" aria-label="Main navigation">
  <div class="sidebar-header">
    <button
      class="mobile-menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-controls="dashboardNav"
      aria-expanded="false"
      data-mobile-menu-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>
    <a href="{{ path('pro_admin_dashboard') }}" class="sidebar-logo">Glam<span>4Style</span></a>
  </div>

  <nav class="sidebar-nav" id="dashboardNav">
    <a href="{{ path('pro_admin_appointments_upcoming') }}"
       class="{{ activeTab == 'upcoming' ? 'active' : '' }}"
       aria-current="{{ activeTab == 'upcoming' ? 'page' : 'false' }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <rect x="1" y="3" width="14" height="12" rx="1"/><path d="M5 1v4M11 1v4M1 7h14"/>
      </svg>
      Upcoming
    </a>
    <a href="{{ path('pro_admin_appointments_past') }}"
       class="{{ activeTab == 'past' ? 'active' : '' }}"
       aria-current="{{ activeTab == 'past' ? 'page' : 'false' }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <circle cx="8" cy="8" r="6.5"/><path d="M8 5v3.5l2.5 1.5"/>
      </svg>
      Past
    </a>
    <a href="{{ path('pro_admin_services_index') }}"
       class="{{ activeTab == 'services' ? 'active' : '' }}"
       aria-current="{{ activeTab == 'services' ? 'page' : 'false' }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M2 4h12M2 8h8M2 12h10"/>
      </svg>
      Services
    </a>
    <a href="{{ path('pro_admin_opening_hours') }}"
       class="{{ activeTab == 'opening_hours' ? 'active' : '' }}"
       aria-current="{{ activeTab == 'opening_hours' ? 'page' : 'false' }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <circle cx="8" cy="8" r="6.5"/><path d="M8 3v5h4"/>
      </svg>
      Opening hours
    </a>
  </nav>

  <div class="sidebar-footer">
    <a href="{{ path('app_logout') }}" class="logout-btn">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M6 2H2v12h4M11 5l3 3-3 3M5 8h9"/>
      </svg>
      Log out
    </a>
  </div>
</aside>

{# ── MAIN ── #}
<main class="main">

  {# ════════════════════════════════════ UPCOMING TAB ════ #}
  {% if activeTab == 'upcoming' %}

  <header class="main-header">
    <p class="page-eyebrow">What's ahead</p>
    <h1 class="page-title">Upcoming <em>appointments</em></h1>
  </header>

  <div class="main-content">
    {% if upcomingAppointments is empty %}
      <div class="empty">
        <span class="empty-mark">✦</span>
        <p>No appointments scheduled yet.</p>
      </div>
    {% else %}
      {# Group by date — in a real app, group in the controller or with a macro #}
      {% set currentDay = null %}
      {% for appt in upcomingAppointments %}
        {% set apptDay = appt.date|date('Y-m-d') %}
        {% if apptDay != currentDay %}
          {% if currentDay is not null %}</div>{% endif %}
          <div class="day-group">
          <p class="day-label">{{ appt.date|date('l, d MMMM') }}</p>
          {% set currentDay = apptDay %}
        {% endif %}

        <div class="appt-row" id="appt-{{ appt.id }}">
          <span class="appt-time">{{ appt.date|date('g:i A') }}</span>

          <div class="appt-info">
            <p class="appt-client">{{ appt.clientName }}</p>
            <p class="appt-meta">
              <span class="appt-dot"></span>
              {{ appt.serviceName }}
            </p>
          </div>

          <span class="appt-duration-pill">{{ appt.durationMinutes }} min</span>

          <div class="appt-actions">
            <button class="icon-btn"
                    aria-label="Edit appointment for {{ appt.clientName }}"
                    onclick="openEditModal({{ appt.id }}, '{{ appt.date|date('Y-m-d\\TH:i') }}', {{ appt.durationMinutes }}, '{{ appt.clientName|e('js') }}')">
              {# pencil #}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M11 2l3 3L5 14H2v-3L11 2z"/>
              </svg>
            </button>
            <button class="icon-btn danger"
                    aria-label="Delete appointment for {{ appt.clientName }}"
                    onclick="openDeleteModal({{ appt.id }}, '{{ appt.clientName|e('js') }}')">
              {# trash #}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 4h12M6 4V2h4v2M5 4l1 10h4l1-10"/>
              </svg>
            </button>
          </div>
        </div>
      {% endfor %}
      {% if currentDay is not null %}</div>{% endif %}
    {% endif %}
  </div>

  {# ════════════════════════════════════ PAST TAB ════ #}
  {% elseif activeTab == 'past' %}

  <header class="main-header">
    <p class="page-eyebrow">History</p>
    <h1 class="page-title">Past <em>appointments</em></h1>
  </header>

  <div class="main-content">
    {% if pastAppointments is empty %}
      <div class="empty">
        <span class="empty-mark">✦</span>
        <p>No past appointments yet.</p>
      </div>
    {% else %}
      {% set currentDay = null %}
      {% for appt in pastAppointments %}
        {% set apptDay = appt.date|date('Y-m-d') %}
        {% if apptDay != currentDay %}
          {% if currentDay is not null %}</div>{% endif %}
          <div class="day-group">
          <p class="day-label">{{ appt.date|date('l, d MMMM') }}</p>
          {% set currentDay = apptDay %}
        {% endif %}

        <div class="appt-row past">
          <span class="appt-time">{{ appt.date|date('g:i A') }}</span>
          <div class="appt-info">
            <p class="appt-client">{{ appt.clientName }}</p>
            <p class="appt-meta">
              <span class="appt-dot"></span>
              {{ appt.serviceName }}
            </p>
          </div>
          <span class="appt-duration-pill">{{ appt.durationMinutes }} min</span>
          <div class="appt-actions">{# read-only — no edit/delete #}</div>
        </div>
      {% endfor %}
      {% if currentDay is not null %}</div>{% endif %}
    {% endif %}
  </div>

  {# ════════════════════════════════════ SERVICES TAB ════ #}
  {% elseif activeTab == 'services' %}

  <header class="main-header">
    <p class="page-eyebrow">What you offer</p>
    <h1 class="page-title">Your <em>services</em></h1>
  </header>

  <div class="main-content">
    {% if services is empty %}
      <div class="empty">
        <span class="empty-mark">✦</span>
        <p>No services added yet.</p>
      </div>
    {% else %}
      <div class="services-grid">
        {% for service in services %}
        <div class="service-card">
          <p class="service-name">{{ service.name }}</p>
          <p class="service-meta">
            <span>{{ service.durationMinutes }} min</span>
          </p>
          <p class="service-description">{{ service.description }}</p>
          <p class="service-price">${{ service.price }}</p>
        </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% endif %}

</main>{# /main #}


{# ── EDIT MODAL ── #}
<div class="modal-overlay" id="editModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
  <div class="modal">
    <button class="modal-close" onclick="closeEditModal()" aria-label="Close">×</button>

    <p class="modal-eyebrow">Edit appointment</p>
    <h2 class="modal-title" id="editModalTitle">Update details</h2>

    <div class="notice-banner">
      <strong>Remember —</strong> if you change the date or duration, please contact your client directly to confirm.
    </div>

    <form id="editForm" method="post" action="">
      {# action set via JS: path('appointment_edit', {id: X}) #}
      <input type="hidden" name="_method" value="PATCH">
      <input type="hidden" name="_token" value="{{ csrf_token('edit_appointment') }}">

      <div class="form-field">
        <label class="form-label" for="edit-date">Date &amp; time</label>
        <input class="form-input" type="datetime-local" id="edit-date" name="date" required>
      </div>

      <div class="form-field">
        <label class="form-label" for="edit-duration">Duration (minutes)</label>
        <input class="form-input" type="number" id="edit-duration" name="durationMinutes" min="5" step="5" required>
      </div>

      <div class="modal-actions">
        <button type="submit" class="btn-primary">Save changes</button>
        <button type="button" class="btn-ghost" onclick="closeEditModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

{# ── DELETE CONFIRM MODAL ── #}
<div class="modal-overlay" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
  <div class="modal">
    <button class="modal-close" onclick="closeDeleteModal()" aria-label="Close">×</button>

    <p class="modal-eyebrow">Remove appointment</p>
    <h2 class="modal-title" id="deleteModalTitle">Delete this appointment?</h2>

    <p class="delete-warning" id="deleteWarningText">
      This will permanently remove the appointment. Your client will not be notified automatically — reach out to them directly if needed.
    </p>

    <form id="deleteForm" method="post" action="">
      <input type="hidden" name="_method" value="DELETE">
      <input type="hidden" name="_token" value="{{ csrf_token('delete_appointment') }}">

      <div class="modal-actions">
        <button type="submit" class="btn-danger">Yes, delete</button>
        <button type="button" class="btn-ghost" onclick="closeDeleteModal()">Keep it</button>
      </div>
    </form>
  </div>
</div>

<script>
  const sidebar = document.querySelector('.sidebar');
  const mobileMenuToggle = document.querySelector('[data-mobile-menu-toggle]');

  if (sidebar && mobileMenuToggle) {
    mobileMenuToggle.addEventListener('click', () => {
      const isOpen = sidebar.classList.toggle('is-open');

      mobileMenuToggle.setAttribute('aria-expanded', String(isOpen));
      mobileMenuToggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
    });
  }

  /* ── EDIT MODAL ── */
  const editModal   = document.getElementById('editModal');
  const editForm    = document.getElementById('editForm');
  const editTitle   = document.getElementById('editModalTitle');
  const editDateEl  = document.getElementById('edit-date');
  const editDurEl   = document.getElementById('edit-duration');

  function openEditModal(id, datetime, duration, clientName) {
    editTitle.textContent = 'Update ' + clientName + '\'s appointment';
    editDateEl.value      = datetime;
    editDurEl.value       = duration;
    // Route generated server-side; build dynamically from a data attribute or template
    editForm.action = '/appointments/' + id + '/edit'; // adjust to match your Symfony route
    editModal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeEditModal() {
    editModal.classList.remove('open');
    document.body.style.overflow = '';
  }

  /* ── DELETE MODAL ── */
  const deleteModal    = document.getElementById('deleteModal');
  const deleteForm     = document.getElementById('deleteForm');
  const deleteWarning  = document.getElementById('deleteWarningText');

  function openDeleteModal(id, clientName) {
    deleteWarning.textContent =
      'This will permanently remove ' + clientName + '\'s appointment. '
      + 'Your client will not be notified automatically — reach out to them directly if needed.';
    deleteForm.action = '/appointments/' + id; // adjust to match your Symfony DELETE route
    deleteModal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDeleteModal() {
    deleteModal.classList.remove('open');
    document.body.style.overflow = '';
  }

  /* Close on overlay click */
  [editModal, deleteModal].forEach(overlay => {
    overlay.addEventListener('click', e => {
      if (e.target === overlay) {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  });

  /* Close on Escape */
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      closeEditModal();
      closeDeleteModal();
    }
  });
</script>
</body>
</html>
