{#
  templates/pro_admin/dashboard.html.twig
  Variables expected from controller:
    - upcomingAppointments: Appointment[]  (date >= today, ordered ASC)
    - pastAppointments:     Appointment[]  (date < today,  ordered DESC)
    - services:             Service[]
    - activeTab:            string  ('upcoming'|'past'|'services'|'opening_hours')  default 'upcoming'
  Each Appointment has:
    - id, clientName, clientTéléphone, serviceName, date (DateTime), durationMinutes
  Each Service has:
    - id, name, description, durationMinutes, price
#}
{% set dashboardUrl = dashboardUrl|default(path('demo_pro_admin_dashboard')) %}
{% set frontUrl = frontUrl|default(path('demo_front_pro_home')) %}
{% set isDemoDashboard = isDemoDashboard|default(true) %}
{% set logoutUrl = logoutUrl|default(null) %}
{% set openingHoursUrl = openingHoursUrl|default(path('demo_pro_admin_opening_hours')) %}
{% set pastUrl = pastUrl|default(path('demo_pro_admin_appointments_past')) %}
{% set servicesUrl = servicesUrl|default(path('demo_pro_admin_services_index')) %}
{% set upcomingAppointmentsApiUrl = upcomingAppointmentsApiUrl|default(null) %}
{% set upcomingAppointmentsLoadError = upcomingAppointmentsLoadError|default(null) %}
{% set upcomingUrl = upcomingUrl|default(path('demo_pro_admin_appointments_upcoming')) %}
{% set frenchMonths = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
{% set frenchWeekdays = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'] %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard â€” Glam4Style</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    /* â”€â”€ TOKENS â”€â”€ */
    :root {
      --cream:       #FAF6F1;
      --blush:       #F2E0D6;
      --rose:        #D4998A;
      --rose-deep:   #B8765F;
      --charcoal:    #1C1916;
      --warm-grey:   #6B5F58;
      --mid:         #A89890;
      --soft-border: rgba(180,150,135,0.22);
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans:  'DM Sans', system-ui, sans-serif;
      --sidebar-w: 220px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--cream);
      color: var(--charcoal);
      font-family: var(--sans);
      font-weight: 300;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
    }

    /* â”€â”€ SIDEBAR â”€â”€ */
    .sidebar {
      width: var(--sidebar-w);
      flex-shrink: 0;
      background: var(--charcoal);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 36px 0 32px;
      position: fixed;
      top: 0; left: 0; bottom: 0;
      z-index: 50;
    }

    .sidebar-logo {
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--cream);
      text-decoration: none;
      padding: 0 28px 36px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      display: block;
    }
    .sidebar-logo span { color: var(--rose); }

    .sidebar-nav {
      flex: 1;
      padding: 28px 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .sidebar-nav a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 28px;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.03em;
      color: rgba(255,255,255,0.45);
      text-decoration: none;
      transition: color 0.18s, background 0.18s;
      position: relative;
    }
    .sidebar-nav a:hover {
      color: var(--cream);
      background: rgba(255,255,255,0.05);
    }
    .sidebar-nav a.active {
      color: var(--cream);
    }
    .sidebar-nav a.active::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: var(--rose);
    }

    .nav-icon {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      opacity: 0.6;
    }
    .sidebar-nav a.active .nav-icon,
    .sidebar-nav a:hover .nav-icon { opacity: 1; }

    .sidebar-footer {
      padding: 24px 28px 0;
      border-top: 1px solid rgba(255,255,255,0.07);
    }

    .mobile-menu-toggle {
      display: none;
    }

    .logout-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      text-decoration: none;
      transition: color 0.18s;
    }
    .logout-btn:hover { color: var(--rose); }

    /* â”€â”€ MAIN â”€â”€ */
    .main {
      margin-left: var(--sidebar-w);
      flex: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .main-header {
      padding: 40px 52px 0;
      border-bottom: 1px solid var(--soft-border);
      padding-bottom: 0;
    }

    .page-eyebrow {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--rose-deep);
      margin-bottom: 6px;
    }

    .page-title {
      font-family: var(--serif);
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 300;
      line-height: 1.15;
      padding-bottom: 28px;
    }
    .page-title em { font-style: italic; color: var(--rose-deep); }

    .main-content {
      padding: 40px 52px 60px;
      flex: 1;
    }

    /* â”€â”€ APPOINTMENT LIST â”€â”€ */
    .day-group { margin-bottom: 40px; }

    .day-label {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--mid);
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--soft-border);
    }

    .appt-row {
      display: grid;
      grid-template-columns: 80px 1fr auto auto;
      align-items: center;
      gap: 20px;
      padding: 16px 0;
      border-bottom: 1px solid var(--soft-border);
      transition: opacity 0.35s ease;
    }
    .appt-row:first-of-type { border-top: none; }
    .appt-row.removing { opacity: 0; pointer-events: none; }

    .appt-time {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 300;
      color: var(--charcoal);
      white-space: nowrap;
    }

    .appt-info {}
    .appt-client {
      font-size: 15px;
      font-weight: 400;
      color: var(--charcoal);
      margin-bottom: 2px;
    }
    .appt-meta {
      font-size: 12px;
      color: var(--mid);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .appt-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--rose);
      display: inline-block;
      flex-shrink: 0;
    }

    .appt-duration-pill {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.06em;
      color: var(--warm-grey);
      background: var(--blush);
      border: 1px solid var(--soft-border);
      padding: 4px 10px;
      white-space: nowrap;
      align-self: center;
    }

    .appt-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .icon-btn {
      background: none;
      border: 1px solid var(--soft-border);
      width: 34px; height: 34px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      color: var(--mid);
      transition: border-color 0.18s, color 0.18s, background 0.18s;
    }
    .icon-btn:hover { border-color: var(--rose); color: var(--rose-deep); background: var(--blush); }
    .icon-btn.danger:hover { border-color: #c0392b; color: #c0392b; background: #fff5f5; }

    /* â”€â”€ PAST APPOINTMENTS â”€â”€ */
    .appt-row.past .appt-time { color: var(--mid); }
    .appt-row.past .appt-client { color: var(--warm-grey); }
    .appt-row.past .appt-dot { background: var(--soft-border); }

    /* â”€â”€ SERVICES LIST â”€â”€ */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1px;
      background: var(--soft-border);
      border: 1px solid var(--soft-border);
    }

    .service-card {
      background: var(--cream);
      padding: 28px 32px;
      transition: background 0.18s;
    }
    .service-card:hover { background: var(--blush); }

    .service-name {
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 400;
      margin-bottom: 6px;
    }
    .service-meta {
      font-size: 12px;
      color: var(--mid);
      display: flex;
      gap: 14px;
    }
    .service-description {
      color: var(--warm-grey);
      font-size: 13px;
      line-height: 1.55;
      margin-top: 10px;
    }
    .service-price {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 300;
      color: var(--charcoal);
      margin-top: 14px;
    }

    /* â”€â”€ EMPTY STATES â”€â”€ */
    .empty {
      padding: 64px 0;
      text-align: center;
      color: var(--mid);
    }
    .empty-mark {
      font-family: var(--serif);
      font-size: 48px;
      font-weight: 300;
      color: var(--blush);
      display: block;
      margin-bottom: 12px;
    }
    .empty p { font-size: 14px; }

    /* â”€â”€ EDIT MODAL â”€â”€ */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(28,25,22,0.55);
      backdrop-filter: blur(6px);
      z-index: 200;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      opacity: 0; pointer-events: none;
      transition: opacity 0.28s ease;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }

    .modal {
      background: var(--cream);
      width: 100%; max-width: 440px;
      padding: 52px 44px;
      position: relative;
      transform: translateY(18px);
      transition: transform 0.32s ease;
    }
    .modal-overlay.open .modal { transform: translateY(0); }

    .modal-close {
      position: absolute; top: 18px; right: 22px;
      background: none; border: none; font-size: 22px;
      color: var(--mid); cursor: pointer;
      transition: color 0.18s;
    }
    .modal-close:hover { color: var(--charcoal); }

    .modal-eyebrow {
      font-size: 10px; font-weight: 500;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--rose-deep); margin-bottom: 10px;
    }
    .modal-title {
      font-family: var(--serif);
      font-size: 32px; font-weight: 300; line-height: 1.2;
      margin-bottom: 24px;
    }

    /* Contact notice banner */
    .notice-banner {
      background: var(--blush);
      border-left: 2px solid var(--rose-deep);
      padding: 12px 16px;
      font-size: 13px;
      color: var(--warm-grey);
      line-height: 1.5;
      margin-bottom: 28px;
    }
    .notice-banner strong { color: var(--rose-deep); font-weight: 500; }

    .form-field { margin-bottom: 18px; }

    .form-label {
      display: block;
      font-size: 10px; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--warm-grey);
      margin-bottom: 8px;
    }

    .form-input {
      width: 100%;
      border: 1px solid var(--soft-border);
      background: var(--blush);
      padding: 12px 16px;
      font-family: var(--sans);
      font-size: 14px; color: var(--charcoal);
      outline: none;
      transition: border-color 0.18s;
      appearance: none;
    }
    .form-input:focus { border-color: var(--rose); }

    .modal-actions {
      display: flex; gap: 12px; margin-top: 28px;
    }

    .btn-primary {
      font-family: var(--sans);
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--cream); background: var(--charcoal);
      border: none; padding: 13px 28px;
      cursor: pointer;
      transition: background 0.18s, transform 0.12s;
    }
    .btn-primary:hover { background: var(--rose-deep); transform: translateY(-1px); }

    .btn-ghost {
      font-family: var(--sans);
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--warm-grey); background: none;
      border: 1px solid var(--soft-border);
      padding: 13px 28px;
      cursor: pointer;
      transition: border-color 0.18s, color 0.18s;
    }
    .btn-ghost:hover { border-color: var(--rose); color: var(--rose-deep); }

    /* â”€â”€ CONFIRM DELETE MODAL â”€â”€ */
    #deleteModal .modal { max-width: 380px; padding: 44px 40px; }
    .delete-warning {
      font-size: 13px; color: var(--warm-grey);
      margin-bottom: 28px; line-height: 1.6;
    }
    .btn-danger {
      font-family: var(--sans);
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: #fff; background: #b83232;
      border: none; padding: 13px 28px;
      cursor: pointer;
      transition: background 0.18s;
    }
    .btn-danger:hover { background: #8c1f1f; }

    /* â”€â”€ MOBILE â”€â”€ */
    @media (max-width: 768px) {
      :root { --sidebar-w: 0px; }
      body {
        display: block;
        padding-top: 58px;
      }

      .sidebar {
        bottom: auto;
        height: auto;
        width: 100%;
        min-height: auto;
        flex-direction: column;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding: 0;
        z-index: 100;
        box-shadow: 0 8px 24px rgba(28,25,22,0.12);
      }

      .sidebar-header {
        align-items: center;
        display: flex;
        min-height: 58px;
        width: 100%;
      }

      .mobile-menu-toggle {
        align-items: center;
        background: none;
        border: 0;
        border-right: 1px solid rgba(255,255,255,0.07);
        color: var(--cream);
        cursor: pointer;
        display: flex;
        height: 58px;
        justify-content: center;
        padding: 0;
        width: 58px;
      }

      .mobile-menu-toggle svg {
        height: 22px;
        width: 22px;
      }

      .sidebar-logo {
        border-bottom: none;
        flex: 1;
        padding: 16px 20px;
      }

      .sidebar-nav,
      .sidebar-footer {
        display: none;
        width: 100%;
      }

      .sidebar.is-open .sidebar-nav,
      .sidebar.is-open .sidebar-footer {
        display: flex;
      }

      .sidebar-nav {
        border-top: 1px solid rgba(255,255,255,0.07);
        flex: none;
        flex-direction: column;
        gap: 0;
        padding: 8px 0;
      }

      .sidebar-nav a {
        padding: 14px 20px;
        white-space: nowrap;
      }

      .sidebar-nav a.active::before {
        bottom: 0;
        height: auto;
        left: 0;
        right: auto;
        top: 0;
        width: 2px;
      }

      .sidebar-footer {
        border-top: 1px solid rgba(255,255,255,0.07);
        padding: 16px 20px 18px;
      }

      .main { margin-left: 0; }
      .main-header, .main-content { padding-left: 20px; padding-right: 20px; }
      .appt-row { grid-template-columns: 60px 1fr auto; }
      .appt-duration-pill { display: none; }
      .modal { padding: 36px 24px; }
    }
  </style>
</head>
<body>

{# â”€â”€ SIDEBAR â”€â”€ #}
<aside class="sidebar" role="navigation" aria-label="Navigation principale">
  <div class="sidebar-header">
    <button
      class="mobile-menu-toggle"
      type="button"
      aria-label="Ouvrir la navigation"
      aria-controls="dashboardNav"
      aria-expanded="false"
      data-mobile-menu-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>
    <a href="{{ dashboardUrl }}" class="sidebar-logo">Glam<span>4Style</span></a>
  </div>

  <nav class="sidebar-nav" id="dashboardNav">
    <a href="{{ calendarUrl }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <rect x="1" y="2.5" width="14" height="12" rx="1"/><path d="M1 6h14M5 1v3M11 1v3"/>
      </svg>
      Calendrier
    </a>
    <a href="{{ upcomingUrl }}"
       class="{{ activeTab == 'upcoming' ? 'active' : '' }}"
       aria-current="{{ activeTab == 'upcoming' ? 'page' : 'false' }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <rect x="1" y="3" width="14" height="12" rx="1"/><path d="M5 1v4M11 1v4M1 7h14"/>
      </svg>
      À venir
    </a>
    <a href="{{ pastUrl }}"
       class="{{ activeTab == 'past' ? 'active' : '' }}"
       aria-current="{{ activeTab == 'past' ? 'page' : 'false' }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <circle cx="8" cy="8" r="6.5"/><path d="M8 5v3.5l2.5 1.5"/>
      </svg>
      Passés
    </a>
    <a href="{{ servicesUrl }}"
       class="{{ activeTab == 'services' ? 'active' : '' }}"
       aria-current="{{ activeTab == 'services' ? 'page' : 'false' }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M2 4h12M2 8h8M2 12h10"/>
      </svg>
      Services
    </a>
    <a href="{{ openingHoursUrl }}"
       class="{{ activeTab == 'opening_hours' ? 'active' : '' }}"
       aria-current="{{ activeTab == 'opening_hours' ? 'page' : 'false' }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <circle cx="8" cy="8" r="6.5"/><path d="M8 3v5h4"/>
      </svg>
      Horaires d’ouverture
    </a>
    <a href="{{ frontUrl }}">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M2 8.5L8 3l6 5.5"/><path d="M4 7.5V14h8V7.5"/>
      </svg>
      Voir mon site
    </a>
  </nav>

  <div class="sidebar-footer">
    <a href="{{ isDemoDashboard ? '#' : (logoutUrl ?? '#') }}" class="logout-btn"{% if isDemoDashboard %} data-demo-logout{% endif %}>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M6 2H2v12h4M11 5l3 3-3 3M5 8h9"/>
      </svg>
      Se déconnecter
    </a>
  </div>
</aside>

{# â”€â”€ MAIN â”€â”€ #}
<main class="main">

  {# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• UPCOMING TAB â•â•â•â• #}
  {% if activeTab == 'upcoming' %}

  <header class="main-header">
    <p class="page-eyebrow">À venir</p>
    <h1 class="page-title">Rendez-vous <em>à venir</em></h1>
  </header>

  <div
    class="main-content"
    data-upcoming-appointments-root
    {% if upcomingAppointmentsApiUrl %}data-upcoming-appointments-api-url="{{ upcomingAppointmentsApiUrl }}"{% endif %}
  >
    {% if upcomingAppointments is empty %}
      <div class="empty">
        <span class="empty-mark">âœ¦</span>
        <p data-upcoming-appointments-empty-message>
          {{ upcomingAppointmentsLoadError ?? (upcomingAppointmentsApiUrl ? 'Chargement des rendez-vous…' : 'Aucun rendez-vous planifié.') }}
        </p>
      </div>
    {% else %}
      {# Group by date â€” in a real app, group in the controller or with a macro #}
      {% set currentDay = null %}
      {% for appt in upcomingAppointments %}
        {% set apptDay = appt.date|date('Y-m-d') %}
        {% if apptDay != currentDay %}
          {% if currentDay is not null %}</div>{% endif %}
          <div class="day-group">
          <p class="day-label">{{ frenchWeekdays[appt.date|date('N') - 1]|capitalize }} {{ appt.date|date('d') }} {{ frenchMonths[appt.date|date('n') - 1] }} {{ appt.date|date('Y') }}</p>
          {% set currentDay = apptDay %}
        {% endif %}

        <div class="appt-row" id="appt-{{ appt.id }}">
          <span class="appt-time">{{ appt.date|date('H:i') }}</span>

          <div class="appt-info">
            <p class="appt-client">{{ appt.clientName }}</p>
            <p class="appt-meta">
              <span class="appt-dot"></span>
              {{ appt.serviceName }}
            </p>
          </div>

          <span class="appt-duration-pill">{{ appt.durationMinutes }} min</span>

          <div class="appt-actions">
            <button class="icon-btn"
                    aria-label="Modifier le rendez-vous de {{ appt.clientName }}"
                    onclick="openEditModal({{ appt.id }}, '{{ appt.date|date('Y-m-d\\TH:i') }}', {{ appt.durationMinutes }}, '{{ appt.clientName|e('js') }}')">
              {# pencil #}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M11 2l3 3L5 14H2v-3L11 2z"/>
              </svg>
            </button>
            <button class="icon-btn danger"
                    aria-label="Supprimer le rendez-vous de {{ appt.clientName }}"
                    onclick="openDeleteModal({{ appt.id }}, '{{ appt.clientName|e('js') }}')">
              {# trash #}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 4h12M6 4V2h4v2M5 4l1 10h4l1-10"/>
              </svg>
            </button>
          </div>
        </div>
      {% endfor %}
      {% if currentDay is not null %}</div>{% endif %}
    {% endif %}
  </div>

  {# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• PAST TAB â•â•â•â• #}
  {% elseif activeTab == 'past' %}

  <header class="main-header">
    <p class="page-eyebrow">Historique</p>
    <h1 class="page-title">Rendez-vous <em>passés</em></h1>
  </header>

  <div class="main-content">
    {% if pastAppointments is empty %}
      <div class="empty">
        <span class="empty-mark">âœ¦</span>
        <p>Aucun rendez-vous passé.</p>
      </div>
    {% else %}
      {% set currentDay = null %}
      {% for appt in pastAppointments %}
        {% set apptDay = appt.date|date('Y-m-d') %}
        {% if apptDay != currentDay %}
          {% if currentDay is not null %}</div>{% endif %}
          <div class="day-group">
          <p class="day-label">{{ frenchWeekdays[appt.date|date('N') - 1]|capitalize }} {{ appt.date|date('d') }} {{ frenchMonths[appt.date|date('n') - 1] }} {{ appt.date|date('Y') }}</p>
          {% set currentDay = apptDay %}
        {% endif %}

        <div class="appt-row past">
          <span class="appt-time">{{ appt.date|date('H:i') }}</span>
          <div class="appt-info">
            <p class="appt-client">{{ appt.clientName }}</p>
            <p class="appt-meta">
              <span class="appt-dot"></span>
              {{ appt.serviceName }}
            </p>
          </div>
          <span class="appt-duration-pill">{{ appt.durationMinutes }} min</span>
          <div class="appt-actions">{# read-only â€” no edit/delete #}</div>
        </div>
      {% endfor %}
      {% if currentDay is not null %}</div>{% endif %}
    {% endif %}
  </div>

  {# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• SERVICES TAB â•â•â•â• #}
  {% elseif activeTab == 'services' %}

  <header class="main-header">
    <p class="page-eyebrow">Vos prestations</p>
    <h1 class="page-title">Vos <em>prestations</em></h1>
  </header>

  <div class="main-content">
    {% if services is empty %}
      <div class="empty">
        <span class="empty-mark">âœ¦</span>
        <p>Aucune prestation ajoutée.</p>
      </div>
    {% else %}
      <div class="services-grid">
        {% for service in services %}
        <div class="service-card">
          <p class="service-name">{{ service.name }}</p>
          <p class="service-meta">
            <span>{{ service.durationMinutes }} min</span>
          </p>
          <p class="service-description">{{ service.description }}</p>
          <p class="service-price">{{ service.price }} €</p>
        </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% endif %}

</main>{# /main #}


{# â”€â”€ EDIT MODAL â”€â”€ #}
<div class="modal-overlay" id="editModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
  <div class="modal">
    <button class="modal-close" onclick="closeEditModal()" aria-label="Fermer">Ã—</button>

    <p class="modal-eyebrow">Modifier le rendez-vous</p>
    <h2 class="modal-title" id="editModalTitle">Modifier les informations</h2>

    <div class="notice-banner">
      <strong>Attention —</strong> si vous modifiez la date ou la durée, contactez directement votre cliente pour confirmation.
    </div>

    <form id="editForm" method="post" action="">
      {# action set via JS: path('appointment_edit', {id: X}) #}
      <input type="hidden" name="_method" value="PATCH">
      <input type="hidden" name="_token" value="{{ csrf_token('edit_appointment') }}">

      <div class="form-field">
        <label class="form-label" for="edit-date">Date et heure</label>
        <input class="form-input" type="datetime-local" id="edit-date" name="date" required>
      </div>

      <div class="form-field">
        <label class="form-label" for="edit-duration">Durée (minutes)</label>
        <input class="form-input" type="number" id="edit-duration" name="durationMinutes" min="5" step="5" required>
      </div>

      <div class="modal-actions">
        <button type="submit" class="btn-primary">Enregistrer</button>
        <button type="button" class="btn-ghost" onclick="closeEditModal()">Annuler</button>
      </div>
    </form>
  </div>
</div>

{# â”€â”€ DELETE CONFIRM MODAL â”€â”€ #}
<div class="modal-overlay" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
  <div class="modal">
    <button class="modal-close" onclick="closeDeleteModal()" aria-label="Fermer">Ã—</button>

    <p class="modal-eyebrow">Supprimer le rendez-vous</p>
    <h2 class="modal-title" id="deleteModalTitle">Supprimer ce rendez-vous ?</h2>

    <p class="delete-warning" id="deleteWarningText">
      Le rendez-vous sera définitivement supprimé. Votre cliente ne sera pas prévenue automatiquement : contactez-la directement si nécessaire.
    </p>

    <form id="deleteForm" method="post" action="">
      <input type="hidden" name="_method" value="DELETE">
      <input type="hidden" name="_token" value="{{ csrf_token('delete_appointment') }}">

      <div class="modal-actions">
        <button type="submit" class="btn-danger">Oui, supprimer</button>
        <button type="button" class="btn-ghost" onclick="closeDeleteModal()">Conserver</button>
      </div>
    </form>
  </div>
</div>

<script>
  const sidebar = document.querySelector('.sidebar');
  const mobileMenuToggle = document.querySelector('[data-mobile-menu-toggle]');
  const mainHeader = document.querySelector('.main-header');
  const demoLogout = document.querySelector('[data-demo-logout]');

  if (sidebar && mobileMenuToggle) {
    const closeMobileMenu = () => {
      sidebar.classList.remove('is-open');
      mobileMenuToggle.setAttribute('aria-expanded', 'false');
      mobileMenuToggle.setAttribute('aria-label', 'Ouvrir la navigation');
    };

    mobileMenuToggle.addEventListener('click', () => {
      const isOpen = sidebar.classList.toggle('is-open');

      mobileMenuToggle.setAttribute('aria-expanded', String(isOpen));
      mobileMenuToggle.setAttribute('aria-label', isOpen ? 'Fermer la navigation' : 'Ouvrir la navigation');
    });

    document.addEventListener('click', (event) => {
      if (
        sidebar.classList.contains('is-open')
        && !sidebar.contains(event.target)
        && (!mainHeader || !mainHeader.contains(event.target))
      ) {
        closeMobileMenu();
      }
    });
  }

  if (demoLogout) {
    demoLogout.addEventListener('click', e => {
      e.preventDefault();
    });
  }

  const upcomingAppointmentsRoot = document.querySelector('[data-upcoming-appointments-root]');
  const upcomingAppointmentsApiUrl = upcomingAppointmentsRoot
    ? upcomingAppointmentsRoot.dataset.upcomingAppointmentsApiUrl
    : null;

  const formatAppointmentDate = (date) => {
    return new Intl.DateTimeFormat('fr-FR', {
      day: '2-digit',
      month: 'long',
      weekday: 'long',
      year: 'numeric',
    }).format(date);
  };

  const formatAppointmentTime = (date) => {
    return new Intl.DateTimeFormat('fr-FR', {
      hour: 'numeric',
      minute: '2-digit',
    }).format(date);
  };

  const formatDatetimeLocal = (date) => {
    const pad = (value) => String(value).padStart(2, '0');

    return date.getFullYear()
      + '-' + pad(date.getMonth() + 1)
      + '-' + pad(date.getDate())
      + 'T' + pad(date.getHours())
      + ':' + pad(date.getMinutes());
  };

  const renderUpcomingAppointmentsEmpty = (message) => {
    if (!upcomingAppointmentsRoot) {
      return;
    }

    upcomingAppointmentsRoot.textContent = '';

    const empty = document.createElement('div');
    empty.className = 'empty';

    const mark = document.createElement('span');
    mark.className = 'empty-mark';
    mark.textContent = 'âœ¦';

    const text = document.createElement('p');
    text.textContent = message;

    empty.append(mark, text);
    upcomingAppointmentsRoot.append(empty);
  };

  const buildAppointmentActionButton = (className, label, path, onClick) => {
    const button = document.createElement('button');
    button.className = className;
    button.type = 'button';
    button.setAttribute('aria-label', label);
    button.innerHTML = path;
    button.addEventListener('click', onClick);

    return button;
  };

  const renderUpcomingAppointments = (appointments) => {
    if (!upcomingAppointmentsRoot) {
      return;
    }

    upcomingAppointmentsRoot.textContent = '';

    if (!appointments.length) {
      renderUpcomingAppointmentsEmpty('Aucun rendez-vous planifié.');

      return;
    }

    let currentDay = null;
    let currentGroup = null;
    let renderedCount = 0;

    appointments.forEach((appointment) => {
      const startAt = appointment.start_at ? new Date(appointment.start_at) : null;

      if (!startAt || Number.isNaN(startAt.getTime())) {
        return;
      }

      const dayKey = formatDatetimeLocal(startAt).slice(0, 10);
      const clientName = appointment.client_name || 'Cliente inconnue';
      const duration = appointment.duration_minutes;

      if (dayKey !== currentDay) {
        currentDay = dayKey;
        currentGroup = document.createElement('div');
        currentGroup.className = 'day-group';

        const dayLabel = document.createElement('p');
        dayLabel.className = 'day-label';
        dayLabel.textContent = formatAppointmentDate(startAt);

        currentGroup.append(dayLabel);
        upcomingAppointmentsRoot.append(currentGroup);
      }

      const row = document.createElement('div');
      row.className = 'appt-row';
      row.id = 'appt-' + appointment.id;

      const time = document.createElement('span');
      time.className = 'appt-time';
      time.textContent = formatAppointmentTime(startAt);

      const info = document.createElement('div');
      info.className = 'appt-info';

      const client = document.createElement('p');
      client.className = 'appt-client';
      client.textContent = clientName;

      const meta = document.createElement('p');
      meta.className = 'appt-meta';

      const dot = document.createElement('span');
      dot.className = 'appt-dot';

      meta.append(dot, document.createTextNode(appointment.service_name || 'Prestation non renseignée'));
      info.append(client, meta);

      const durationPill = document.createElement('span');
      durationPill.className = 'appt-duration-pill';
      durationPill.textContent = duration ? duration + ' min' : 'Durée indisponible';

      const actions = document.createElement('div');
      actions.className = 'appt-actions';
      actions.append(
        buildAppointmentActionButton(
          'icon-btn',
          'Modifier le rendez-vous de ' + clientName,
          '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 2l3 3L5 14H2v-3L11 2z"/></svg>',
          () => openEditModal(appointment.id, formatDatetimeLocal(startAt), duration || '', clientName)
        ),
        buildAppointmentActionButton(
          'icon-btn danger',
          'Supprimer le rendez-vous de ' + clientName,
          '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4h12M6 4V2h4v2M5 4l1 10h4l1-10"/></svg>',
          () => openDeleteModal(appointment.id, clientName)
        )
      );

      row.append(time, info, durationPill, actions);
      currentGroup.append(row);
      renderedCount++;
    });

    if (renderedCount === 0) {
      renderUpcomingAppointmentsEmpty('Aucun rendez-vous valide n’a été renvoyé.');
    }
  };

  if (upcomingAppointmentsApiUrl) {
    fetch(upcomingAppointmentsApiUrl, {
      credentials: 'same-origin',
      headers: {
        Accept: 'application/json',
      },
    })
      .then((response) => {
        if (!response.ok) {
          throw new Error('Impossible de charger les rendez-vous.');
        }

        return response.json();
      })
      .then((appointments) => {
        renderUpcomingAppointments(Array.isArray(appointments) ? appointments : []);
      })
      .catch((error) => {
        renderUpcomingAppointmentsEmpty(error.message || 'Impossible de charger les rendez-vous.');
      });
  }

  /* â”€â”€ EDIT MODAL â”€â”€ */
  const editModal   = document.getElementById('editModal');
  const editForm    = document.getElementById('editForm');
  const editTitle   = document.getElementById('editModalTitle');
  const editDateEl  = document.getElementById('edit-date');
  const editDurEl   = document.getElementById('edit-duration');

  function openEditModal(id, datetime, duration, clientName) {
    editTitle.textContent = 'Modifier le rendez-vous de ' + clientName;
    editDateEl.value      = datetime;
    editDurEl.value       = duration;
    editForm.action = window.location.pathname + '#demo-edit-' + id;
    editModal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeEditModal() {
    editModal.classList.remove('open');
    document.body.style.overflow = '';
  }

  /* â”€â”€ DELETE MODAL â”€â”€ */
  const deleteModal    = document.getElementById('deleteModal');
  const deleteForm     = document.getElementById('deleteForm');
  const deleteWarning  = document.getElementById('deleteWarningText');

  function openDeleteModal(id, clientName) {
    deleteWarning.textContent =
      'Le rendez-vous de ' + clientName + ' sera définitivement supprimé. '
      + 'Votre cliente ne sera pas prévenue automatiquement : contactez-la directement si nécessaire.';
    deleteForm.action = window.location.pathname + '#demo-delete-' + id;
    deleteModal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDeleteModal() {
    deleteModal.classList.remove('open');
    document.body.style.overflow = '';
  }

  /* Close on overlay click */
  [editModal, deleteModal].forEach(overlay => {
    overlay.addEventListener('click', e => {
      if (e.target === overlay) {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  });

  /* Close on Escape */
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      closeEditModal();
      closeDeleteModal();
    }
  });

  editForm.addEventListener('submit', e => {
    e.preventDefault();
    closeEditModal();
  });

  deleteForm.addEventListener('submit', e => {
    e.preventDefault();
    closeDeleteModal();
  });
</script>
