{% extends 'base.html.twig' %}
{% set proId = pro_id|default(null) %}

{% block body %}
    <div class="page-content">
        {% if proId %}
            {% set base = '/pro-banners/' ~ proId ~ '/' %}
            {% set maxBanners = 20 %}
            {% for n in 1..maxBanners %}
                <img src="{{ asset(base ~ n ~ '.png') }}" alt="" loading="lazy" decoding="async" style="display:block;width:100%;height:auto;margin:0;" onerror="this.remove()">
            {% endfor %}
        {% endif %}

        <div class="my-4">
            <form id="lead-booking-form" method="post">
                {% if proId %}
                    <input type="hidden" name="proId" value="{{ proId }}">
                {% endif %}

            <h2 class="h4 mb-3">Laissez vos coordonnées pour être recontacté(e)</h2>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label for="lead-firstname" class="form-label">Prénom</label>
                    <input id="lead-firstname" name="firstname" type="text" class="form-control" required placeholder="Votre prénom">
                </div>
                <div class="col-sm-6">
                    <label for="lead-lastname" class="form-label">Nom</label>
                    <input id="lead-lastname" name="lastname" type="text" class="form-control" required placeholder="Votre nom">
                </div>
            </div>

            <div class="mt-3">
                <label for="lead-phone-local" class="form-label">Téléphone (France uniquement)</label>
                <div class="input-group">
                    <span class="input-group-text">+33</span>
                    <input id="lead-phone-local" name="phone" type="tel" inputmode="numeric" class="form-control" required
                           placeholder="0612345678 ou 612345678"
                           pattern="^(?:[1-9][0-9]{8}|0[1-9][0-9]{8})$"
                           maxlength="10"
                           aria-describedby="lead-phone-help lead-phone-error"
                           title="9 chiffres sans 0 (612345678) ou 10 chiffres avec 0 (0612345678)">
                </div>
                <div id="lead-phone-help" class="form-text">Accepte 9 chiffres (sans le 0) ou 10 chiffres (avec 0 initial).</div>
                <div id="lead-phone-error" class="invalid-feedback">Format attendu: +33 suivi de 9 chiffres (ex: +33612345678).</div>
                <input type="hidden" name="phone_cc" value="+33">
            </div>

            <div class="d-flex align-items-center gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Envoyer ma demande de rendez-vous</button>
                <span class="text-muted">Le professionnel vous recontactera rapidement.</span>
            </div>
        </form>
        </div>
    </div>
<script>
  (function() {
    const form = document.getElementById('lead-booking-form');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      const localInput = document.getElementById('lead-phone-local');
      const err = document.getElementById('lead-phone-error');
      if (!localInput) return;
      const raw = (localInput.value || '').replace(/\s+/g, '');
      const nine = /^[1-9][0-9]{8}$/;
      const ten  = /^0[1-9][0-9]{8}$/;
      let normalizedLocal = '';
      if (nine.test(raw)) {
        normalizedLocal = raw;
      } else if (ten.test(raw)) {
        normalizedLocal = raw.substring(1);
      }
      const full = normalizedLocal ? ('+33' + normalizedLocal) : '';
      const reFull = /^\+33[1-9][0-9]{8}$/;
      if (!reFull.test(full)) {
        e.preventDefault();
        // Bootstrap: mark input invalid (shows .invalid-feedback)
        localInput.classList.add('is-invalid');
        localInput.focus();
      } else {
        localInput.classList.remove('is-invalid');
      }
    });
  })();
</script>

<div class='book-appointment'>
    👉 <a href='#lead-booking-form'>Clicker ici pour prendre un rdv avec moi</a> 👈
    </div>
<style>
    .page-content { max-width: 1025px; margin: 0 auto; padding: 0 1rem; }
    html { scroll-behavior: smooth; }
    .book-appointment a,
    .book-appointment a:visited,
    .book-appointment a:hover,
    .book-appointment a:active,
    .book-appointment a:focus {
        text-decoration: none !important;
        color: inherit !important;
        outline: none;
        box-shadow: none;
    }
    .book-appointment {
        text-align: center;
        font-size: clamp(1rem, 3.5vw, 1.5rem);
        background: #FFF;
        position: fixed;
        left: 0;
        right: 0;
        top: 0;
        width: 100%;
        z-index: 1000;
        padding: 0.75rem 1rem;
        box-shadow: 0 -2px 8px rgba(0,0,0,0.08);
    }
    .book-appointment a.btn {
        display: inline-block;
        padding: 0.75rem 1rem;
        min-height: 44px;
        line-height: 1.2;
    }
    #lead-booking-form { scroll-margin-top: 80px; }
    body { padding-top: 72px; }
</style>
{% endblock %}
