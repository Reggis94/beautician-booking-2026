{% extends 'base.html.twig' %}

{% block body %}
    <div class="page-content">
        {% if banner_urls|default([]) is not empty %}
            {% for bannerUrl in banner_urls %}
                <img src="{{ bannerUrl }}" alt="" loading="lazy" decoding="async" class="banner-image">
            {% endfor %}
        {% endif %}

        {% if pro_id|default(null) %}
            <section
                class="service-categories"
                data-category-list-url="{{ path('category_pro_presentation', { id: pro_id }) }}"
                data-service-list-url="{{ path('service_list_per_category') }}"
                data-bookable-days-url="{{ path('get_bookable_days_for_service') }}"
                data-bookable-ranges-url="{{ path('get_bookable_free_ranges_for_service_and_day') }}"
                data-create-appointment-url="{{ path('api_booking_client_create_appointment') }}"
                data-pro-id="{{ pro_id }}"
            >
                <div class="service-categories__header">
                    <p class="service-categories__eyebrow">What we offer</p>
                    <h2>Services</h2>
                    <p class="service-categories__sub">Pick a treatment and request an appointment.</p>
                </div>
                <div class="service-categories__status" data-category-status>Loading categories...</div>
                <div class="service-categories__list" data-category-list></div>
            </section>
        {% endif %}
    </div>

    <div
        class="booking-result-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="bookingResultTitle"
        hidden
        data-booking-result-modal
    >
        <div class="booking-result-modal__backdrop" data-booking-result-close></div>
        <div class="booking-result-modal__dialog">
            <button class="booking-result-modal__close" type="button" aria-label="Close" data-booking-result-close>x</button>
            <p class="booking-result-modal__eyebrow" data-booking-result-eyebrow></p>
            <h2 class="booking-result-modal__title" id="bookingResultTitle" data-booking-result-title></h2>
            <p class="booking-result-modal__body" data-booking-result-body></p>
            <button class="booking-result-modal__action" type="button" data-booking-result-close>Close</button>
        </div>
    </div>

    <style>
        :root {
            --cream: #FAF6F1;
            --blush: #F2E0D6;
            --rose: #D4998A;
            --rose-deep: #B8765F;
            --charcoal: #1C1916;
            --warm-grey: #6B5F58;
            --mid: #A89890;
            --soft-border: rgba(180, 150, 135, 0.22);
            --serif: 'Cormorant Garamond', Georgia, serif;
            --sans: 'DM Sans', system-ui, sans-serif;
        }

        .page-content {
            background: var(--cream);
            color: var(--charcoal);
            font-family: var(--sans);
            font-weight: 300;
            margin: 0 auto;
            max-width: 1025px;
        }
        .banner-image {
            display: block;
            height: auto;
            margin: 0;
            width: 100%;
        }
        .service-categories { padding: 48px 24px 60px; }
        .service-categories__header { margin-bottom: 36px; }
        .service-categories__eyebrow {
            color: var(--rose-deep);
            font-size: 10px;
            font-weight: 500;
            letter-spacing: .2em;
            margin: 0 0 10px;
            text-transform: uppercase;
        }
        .service-categories__header h2 {
            color: var(--charcoal);
            font-family: var(--serif);
            font-size: clamp(28px, 4vw, 42px);
            font-weight: 300;
            line-height: 1.15;
            margin: 0 0 8px;
        }
        .service-categories__sub {
            color: var(--warm-grey);
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
        }
        .service-categories__status {
            color: var(--warm-grey);
            font-size: 13px;
            padding: 0.75rem 0;
        }
        .service-categories__list { display: grid; gap: 16px; }
        .service-category {
            background: var(--cream);
            border: 1px solid var(--soft-border);
            overflow: hidden;
        }
        .service-category__toggle {
            align-items: center;
            background: var(--cream);
            border: 0;
            border-bottom: 1px solid var(--soft-border);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            min-height: 56px;
            padding: 18px 20px;
            text-align: left;
            width: 100%;
        }
        .service-category__main { align-items: center; display: flex; gap: 12px; }
        .service-category__arrow {
            color: var(--mid);
            font-size: 18px;
            line-height: 1;
            width: 16px;
        }
        .service-category__name {
            color: var(--charcoal);
            font-family: var(--serif);
            font-size: 20px;
            font-weight: 400;
        }
        .service-category__count {
            color: var(--mid);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .1em;
            text-transform: uppercase;
        }
        .service-category__services {
            background: var(--blush);
            display: grid;
            gap: 1px;
            padding: 0;
        }
        .service-category__services[hidden] { display: none; }
        .service-card {
            background: var(--cream);
            padding: 24px 20px 24px 32px;
            position: relative;
            transition: background .18s;
        }
        .service-card:hover { background: #FEFCF9; }
        .service-card__header {
            align-items: flex-start;
            display: flex;
            gap: 12px;
            justify-content: space-between;
            margin-bottom: 6px;
        }
        .service-card__name {
            color: var(--charcoal);
            font-family: var(--serif);
            font-size: 22px;
            font-weight: 400;
            line-height: 1.2;
            margin: 0;
        }
        .service-card__price {
            color: var(--rose-deep);
            flex-shrink: 0;
            font-family: var(--serif);
            font-size: 22px;
            font-weight: 300;
            white-space: nowrap;
        }
        .service-card__description {
            color: var(--warm-grey);
            font-size: 13px;
            line-height: 1.65;
            margin: 0 0 14px;
        }
        .service-card__meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 16px;
        }
        .service-card__meta-pill {
            background: var(--blush);
            border: 1px solid var(--soft-border);
            color: var(--warm-grey);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .08em;
            padding: 4px 10px;
        }
        .service-card__book {
            background: var(--charcoal);
            border: 0;
            color: var(--cream);
            cursor: pointer;
            font-family: var(--sans);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .1em;
            padding: 11px 22px;
            text-transform: uppercase;
            transition: background .18s, transform .12s;
        }
        .service-card__book:hover {
            background: var(--rose-deep);
            transform: translateY(-1px);
        }
        .service-card__book:disabled { cursor: wait; opacity: 0.75; }
        .service-card__availability {
            border-top: 1px solid var(--soft-border);
            margin-top: 20px;
            padding-top: 20px;
        }
        .service-card__availability[hidden] { display: none; }
        .service-card__availability-title {
            color: var(--charcoal);
            font-family: var(--serif);
            font-size: 17px;
            font-weight: 400;
            margin: 0 0 14px;
        }
        .service-card__availability-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }
        .service-card__availability-nav[hidden] { display: none; }
        .service-card__availability-nav-button {
            background: var(--cream);
            border: 1px solid var(--soft-border);
            color: var(--warm-grey);
            cursor: pointer;
            font-family: var(--sans);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .08em;
            padding: 8px 14px;
            transition: border-color .18s, color .18s, background .18s;
        }
        .service-card__availability-nav-button:hover {
            background: var(--blush);
            border-color: var(--rose);
            color: var(--rose-deep);
        }
        .service-card__availability-nav-button:disabled { cursor: wait; opacity: 0.75; }
        .service-card__availability-status {
            color: var(--warm-grey);
            font-size: 13px;
            line-height: 1.5;
            margin: 0;
        }
        .service-card__availability-days {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 0;
        }
        .service-card__availability-day {
            background: var(--blush);
            border: 1px solid var(--soft-border);
            color: var(--warm-grey);
            cursor: pointer;
            font-family: var(--sans);
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .06em;
            padding: 8px 14px;
            transition: border-color .18s, color .18s, background .18s;
        }
        .service-card__availability-day:hover {
            border-color: var(--rose);
            color: var(--rose-deep);
        }
        .service-card__availability-day.is-selected {
            background: var(--charcoal);
            border-color: var(--charcoal);
            color: var(--cream);
        }
        .service-card__availability-slots {
            border-top: 1px solid var(--soft-border);
            margin-top: 16px;
            padding-top: 16px;
        }
        .service-card__availability-slots[hidden] { display: none; }
        .service-card__availability-slots-title {
            color: var(--mid);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .14em;
            margin: 0 0 12px;
            text-transform: uppercase;
        }
        .service-card__availability-slots-status {
            color: var(--warm-grey);
            font-size: 13px;
            line-height: 1.5;
            margin: 0;
        }
        .service-card__availability-slot-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 0;
        }
        .service-card__availability-slot {
            background: var(--cream);
            border: 1px solid var(--soft-border);
            color: var(--warm-grey);
            cursor: pointer;
            font-family: var(--sans);
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .06em;
            padding: 8px 14px;
            transition: border-color .18s, color .18s, background .18s;
        }
        .service-card__availability-slot:hover {
            background: var(--blush);
            border-color: var(--rose);
            color: var(--rose-deep);
        }
        .service-card__availability-slot.is-selected {
            background: var(--rose-deep);
            border-color: var(--rose-deep);
            color: var(--cream);
        }
        .service-card__booking-form {
            border-top: 1px solid var(--soft-border);
            display: grid;
            gap: 16px;
            margin-top: 20px;
            padding-top: 20px;
        }
        .service-card__booking-form[hidden] { display: none; }
        .service-card__booking-form-title {
            color: var(--charcoal);
            font-family: var(--serif);
            font-size: 17px;
            font-weight: 400;
            margin: 0;
        }
        .service-card__booking-fields {
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
        }
        .service-card__booking-field {
            display: grid;
            gap: 6px;
        }
        .service-card__booking-field label {
            color: var(--warm-grey);
            font-size: 10px;
            font-weight: 500;
            letter-spacing: .16em;
            text-transform: uppercase;
        }
        .service-card__booking-field input {
            -webkit-appearance: none;
            background: var(--blush);
            border: 1px solid var(--soft-border);
            border-radius: 0;
            color: var(--charcoal);
            font-family: var(--sans);
            font-size: 14px;
            outline: none;
            padding: 11px 14px;
            transition: border-color .18s;
        }
        .service-card__booking-field input:focus {
            border-color: var(--rose);
        }
        .service-card__booking-field input::placeholder {
            color: var(--mid);
        }
        .service-card__booking-submit {
            background: var(--rose-deep);
            border: 0;
            color: var(--cream);
            cursor: pointer;
            font-family: var(--sans);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .1em;
            padding: 13px 28px;
            justify-self: start;
            text-transform: uppercase;
            transition: background .18s, transform .12s;
        }
        .service-card__booking-submit:hover {
            background: var(--charcoal);
            transform: translateY(-1px);
        }
        .service-card__booking-submit:disabled { cursor: wait; opacity: 0.75; }
        .service-card__booking-status {
            color: var(--mid);
            font-size: 13px;
            line-height: 1.5;
            margin: 4px 0 0;
        }
        .service-card__booking-status.is-error {
            color: #B3261E;
            font-weight: 400;
        }
        .service-card__booking-status.is-success {
            color: #3B6D11;
            font-weight: 400;
        }
        .booking-result-modal {
            align-items: center;
            display: flex;
            inset: 0;
            justify-content: center;
            padding: 24px;
            position: fixed;
            z-index: 50;
        }
        .booking-result-modal[hidden] { display: none; }
        .booking-result-modal__backdrop {
            background: rgba(28, 25, 22, .42);
            inset: 0;
            position: absolute;
        }
        .booking-result-modal__dialog {
            background: var(--cream);
            border: 1px solid var(--soft-border);
            box-shadow: 0 24px 70px rgba(28, 25, 22, .24);
            max-width: 420px;
            padding: 40px 32px 32px;
            position: relative;
            width: min(100%, 420px);
        }
        .booking-result-modal__close {
            background: transparent;
            border: 0;
            color: var(--mid);
            cursor: pointer;
            font-family: var(--sans);
            font-size: 18px;
            line-height: 1;
            padding: 8px;
            position: absolute;
            right: 14px;
            top: 14px;
        }
        .booking-result-modal__close:hover { color: var(--charcoal); }
        .booking-result-modal__eyebrow {
            color: var(--rose-deep);
            font-size: 10px;
            font-weight: 500;
            letter-spacing: .2em;
            margin: 0 0 10px;
            text-transform: uppercase;
        }
        .booking-result-modal__title {
            color: var(--charcoal);
            font-family: var(--serif);
            font-size: 30px;
            font-weight: 300;
            line-height: 1.15;
            margin: 0 0 12px;
        }
        .booking-result-modal__body {
            color: var(--warm-grey);
            font-size: 14px;
            line-height: 1.65;
            margin: 0 0 24px;
        }
        .booking-result-modal__action {
            background: var(--charcoal);
            border: 0;
            color: var(--cream);
            cursor: pointer;
            font-family: var(--sans);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .1em;
            padding: 11px 22px;
            text-transform: uppercase;
            transition: background .18s, transform .12s;
        }
        .booking-result-modal__action:hover {
            background: var(--rose-deep);
            transform: translateY(-1px);
        }

        @media (max-width: 600px) {
            .service-categories { padding: 36px 16px 48px; }
            .service-card { padding: 20px 16px; }
            .booking-result-modal__dialog { padding: 36px 24px 28px; }
            .service-card__name { font-size: 19px; }
        }
    </style>

    <script>
        (() => {
            const section = document.querySelector('[data-category-list-url]');

            if (!section) {
                return;
            }

            const list = section.querySelector('[data-category-list]');
            const status = section.querySelector('[data-category-status]');
            const categoryListUrl = section.dataset.categoryListUrl;
            const serviceListUrl = section.dataset.serviceListUrl;
            const bookableDaysUrl = section.dataset.bookableDaysUrl;
            const bookableRangesUrl = section.dataset.bookableRangesUrl;
            const createAppointmentUrl = section.dataset.createAppointmentUrl;
            const proId = Number(section.dataset.proId);
            const bookingResultModal = document.querySelector('[data-booking-result-modal]');
            const bookingResultEyebrow = bookingResultModal
                ? bookingResultModal.querySelector('[data-booking-result-eyebrow]')
                : null;
            const bookingResultTitle = bookingResultModal
                ? bookingResultModal.querySelector('[data-booking-result-title]')
                : null;
            const bookingResultBody = bookingResultModal
                ? bookingResultModal.querySelector('[data-booking-result-body]')
                : null;

            const openBookingResultModal = (kind, title, body) => {
                if (!bookingResultModal || !bookingResultEyebrow || !bookingResultTitle || !bookingResultBody) {
                    return;
                }

                bookingResultEyebrow.textContent = kind === 'success' ? 'Appointment requested' : 'Booking failed';
                bookingResultTitle.textContent = title;
                bookingResultBody.textContent = body;
                bookingResultModal.hidden = false;
            };
            const closeBookingResultModal = () => {
                if (bookingResultModal) {
                    bookingResultModal.hidden = true;
                }
            };

            document.querySelectorAll('[data-booking-result-close]').forEach((button) => {
                button.addEventListener('click', closeBookingResultModal);
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    closeBookingResultModal();
                }
            });
            const scrollToBookingStep = (element) => {
                if (!element) {
                    return;
                }

                window.requestAnimationFrame(() => {
                    element.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start',
                    });
                });
            };

            const setStatus = (message) => {
                if (status) {
                    status.textContent = message;
                }
            };

            const pluralizeServices = (count) => count > 1 ? 'services' : 'service';
            const formatDuration = (durationMin) => {
                if (durationMin === null || durationMin === undefined) {
                    return 'Duration not specified';
                }

                const minutes = Number(durationMin || 0);

                return minutes > 0 ? `${minutes} min` : 'Duration not specified';
            };
            const formatPrice = (priceCents) => {
                if (priceCents === null || priceCents === undefined) {
                    return 'Price not specified';
                }

                const cents = Number(priceCents);

                if (!Number.isFinite(cents)) {
                    return 'Price not specified';
                }

                return new Intl.NumberFormat('en-US', {
                    currency: 'USD',
                    style: 'currency',
                }).format(cents / 100);
            };
            const capitalizeFirstLetter = (value) => {
                const text = String(value || '').trim();

                if (text === '') {
                    return 'Undefined category';
                }

                return text.charAt(0).toUpperCase() + text.slice(1);
            };
            const getCurrentYearMonth = () => {
                const now = new Date();
                const month = String(now.getMonth() + 1).padStart(2, '0');

                return `${now.getFullYear()}-${month}`;
            };
            const getCurrentLocalDate = () => {
                const now = new Date();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');

                return `${now.getFullYear()}-${month}-${day}`;
            };
            const getCurrentMinuteOfDay = () => {
                const now = new Date();

                return (now.getHours() * 60) + now.getMinutes() + (now.getSeconds() > 0 ? 1 : 0);
            };
            const addMonths = (yearMonth, monthsToAdd) => {
                const [year, month] = yearMonth.split('-').map(Number);
                const date = new Date(year, month - 1 + monthsToAdd, 1);
                const nextMonth = String(date.getMonth() + 1).padStart(2, '0');

                return `${date.getFullYear()}-${nextMonth}`;
            };
            const formatMonthLabel = (yearMonth) => {
                const [year, month] = yearMonth.split('-').map(Number);
                const monthDate = new Date(year, month - 1, 1);

                return new Intl.DateTimeFormat('en-US', {
                    month: 'long',
                    year: 'numeric',
                }).format(monthDate);
            };
            const formatBookableDay = (dateString) => {
                const [year, month, day] = String(dateString).split('-').map(Number);
                const date = new Date(year, month - 1, day);

                return new Intl.DateTimeFormat('en-US', {
                    day: 'numeric',
                    weekday: 'short',
                }).format(date);
            };
            const formatTimeWithMeridiem = (time) => {
                const [hours, minutes] = String(time).split(':').map(Number);
                const period = hours >= 12 ? 'PM' : 'AM';
                const displayHours = hours % 12 || 12;
                const displayMinutes = String(minutes).padStart(2, '0');

                return `${displayHours}:${displayMinutes} ${period}`;
            };
            const formatSelectedAppointment = (localDate, startTime) => {
                return `${formatBookableDay(localDate)} at ${formatTimeWithMeridiem(startTime)}`;
            };
            const buildBookableDaysUrl = (serviceId, yearMonth) => {
                const params = new URLSearchParams({
                    serviceId: String(serviceId),
                    yearMonth,
                });

                return `${bookableDaysUrl}?${params.toString()}`;
            };
            const buildBookableRangesUrl = (serviceId, localDate) => {
                const params = new URLSearchParams({
                    localDate,
                    serviceId: String(serviceId),
                });

                return `${bookableRangesUrl}?${params.toString()}`;
            };
            const buildLocalStartDateTime = (localDate, startTime) => {
                return `${localDate} ${startTime}:00`;
            };
            const parseTimeToMinutes = (time) => {
                const [hours, minutes] = String(time).split(':').map(Number);

                return (hours * 60) + minutes;
            };
            const formatMinutesAsTime = (totalMinutes) => {
                const hours = String(Math.floor(totalMinutes / 60)).padStart(2, '0');
                const minutes = String(totalMinutes % 60).padStart(2, '0');

                return `${hours}:${minutes}`;
            };
            const roundUpToTenMinuteBoundary = (totalMinutes) => {
                return Math.ceil(totalMinutes / 10) * 10;
            };
            const buildTenMinuteSlots = (ranges, localDate) => {
                const slots = [];
                const minimumSlotMinute = localDate === getCurrentLocalDate()
                    ? getCurrentMinuteOfDay() + 60
                    : 0;

                ranges.forEach((range) => {
                    const firstSlot = roundUpToTenMinuteBoundary(
                        Math.max(parseTimeToMinutes(range.start_time), minimumSlotMinute)
                    );
                    const lastSlot = parseTimeToMinutes(range.end_time);

                    for (let slot = firstSlot; slot <= lastSlot; slot += 10) {
                        slots.push(formatMinutesAsTime(slot));
                    }
                });

                return [...new Set(slots)];
            };
            const resetBookableSlots = (availabilityPanel) => {
                const slotsPanel = availabilityPanel.querySelector('[data-availability-slots]');
                const slotsTitle = availabilityPanel.querySelector('[data-availability-slots-title]');
                const slotsStatus = availabilityPanel.querySelector('[data-availability-slots-status]');
                const slotList = availabilityPanel.querySelector('[data-availability-slot-list]');

                availabilityPanel.querySelectorAll('[data-local-date]').forEach((dayButton) => {
                    dayButton.classList.remove('is-selected');
                });

                slotsPanel.hidden = true;
                slotsTitle.textContent = '';
                slotsStatus.hidden = false;
                slotsStatus.textContent = '';
                slotList.replaceChildren();
                availabilityPanel.querySelector('[data-booking-form]').hidden = true;
            };
            const resetBookingForm = (availabilityPanel) => {
                const bookingForm = availabilityPanel.querySelector('[data-booking-form]');
                const bookingStatus = availabilityPanel.querySelector('[data-booking-status]');

                availabilityPanel.querySelectorAll('[data-start-time]').forEach((slotButton) => {
                    slotButton.classList.remove('is-selected');
                });

                bookingForm.hidden = true;
                bookingForm.reset();
                bookingStatus.textContent = '';
                bookingStatus.classList.remove('is-error', 'is-success');
            };
            const showBookingForm = (service, availabilityPanel, slotButton) => {
                const localDate = slotButton.dataset.localDate;
                const startTime = slotButton.dataset.startTime;
                const bookingForm = availabilityPanel.querySelector('[data-booking-form]');
                const bookingTitle = availabilityPanel.querySelector('[data-booking-form-title]');
                const bookingStatus = availabilityPanel.querySelector('[data-booking-status]');

                availabilityPanel.querySelectorAll('[data-start-time]').forEach((button) => {
                    button.classList.toggle('is-selected', button === slotButton);
                });

                bookingForm.hidden = false;
                bookingForm.elements.proId.value = String(proId);
                bookingForm.elements.serviceId.value = String(service.id);
                bookingForm.elements.startDateTimeLocal.value = buildLocalStartDateTime(localDate, startTime);
                bookingTitle.textContent = `Book ${formatSelectedAppointment(localDate, startTime)}`;
                bookingStatus.textContent = '';
                bookingStatus.classList.remove('is-error', 'is-success');
                scrollToBookingStep(bookingForm);
            };
            const submitBookingForm = (event) => {
                event.preventDefault();

                const bookingForm = event.currentTarget;
                const submitButton = bookingForm.querySelector('[data-booking-submit]');
                const bookingStatus = bookingForm.querySelector('[data-booking-status]');
                const payload = {
                    email: bookingForm.elements.email.value.trim(),
                    extraPhone: bookingForm.elements.extraPhone.value.trim(),
                    firstName: bookingForm.elements.firstName.value.trim(),
                    lastName: bookingForm.elements.lastName.value.trim(),
                    proId: Number(bookingForm.elements.proId.value),
                    serviceId: Number(bookingForm.elements.serviceId.value),
                    startDateTimeLocal: bookingForm.elements.startDateTimeLocal.value,
                };

                bookingStatus.textContent = 'Booking appointment...';
                bookingStatus.classList.remove('is-error', 'is-success');
                submitButton.disabled = true;

                fetch(createAppointmentUrl, {
                    body: JSON.stringify(payload),
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                    },
                    method: 'POST',
                })
                    .then((response) => {
                        if (response.status === 201) {
                            return null;
                        }

                        return response.json()
                            .catch(() => ({}))
                            .then((data) => {
                                throw new Error(data.error || 'Appointment booking failed.');
                            });
                    })
                    .then(() => {
                        bookingStatus.textContent = 'Appointment booked.';
                        bookingStatus.classList.add('is-success');
                        openBookingResultModal(
                            'success',
                            'Thank you, your appointment is requested',
                            'We have sent you an email with the appointment details. The business has also been notified.'
                        );
                    })
                    .catch((error) => {
                        bookingStatus.textContent = error.message;
                        bookingStatus.classList.add('is-error');
                        openBookingResultModal(
                            'error',
                            'We could not book this appointment',
                            'Something went wrong while sending your request. Please try again or choose another time.'
                        );
                    })
                    .finally(() => {
                        submitButton.disabled = false;
                    });
            };
            const loadBookableSlots = (service, availabilityPanel, dayButton) => {
                const localDate = dayButton.dataset.localDate;
                const slotsPanel = availabilityPanel.querySelector('[data-availability-slots]');
                const slotsTitle = availabilityPanel.querySelector('[data-availability-slots-title]');
                const slotsStatus = availabilityPanel.querySelector('[data-availability-slots-status]');
                const slotList = availabilityPanel.querySelector('[data-availability-slot-list]');

                availabilityPanel.querySelectorAll('[data-local-date]').forEach((button) => {
                    button.classList.toggle('is-selected', button === dayButton);
                });

                slotsPanel.hidden = false;
                slotsTitle.textContent = `Bookable slots for ${formatBookableDay(localDate)}`;
                slotsStatus.hidden = false;
                slotsStatus.textContent = 'Loading bookable slots...';
                slotList.replaceChildren();
                resetBookingForm(availabilityPanel);
                dayButton.disabled = true;
                scrollToBookingStep(slotsPanel);

                fetch(buildBookableRangesUrl(service.id, localDate), {
                    headers: {
                        'Accept': 'application/json',
                    },
                })
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error('Bookable ranges request failed.');
                        }

                        return response.json();
                    })
                    .then((bookableRanges) => {
                        const slots = Array.isArray(bookableRanges)
                            ? buildTenMinuteSlots(bookableRanges, localDate)
                            : [];

                        if (slots.length === 0) {
                            slotsStatus.hidden = false;
                            slotsStatus.textContent = 'No bookable slots available for this day.';
                            return;
                        }

                        const slotButtons = slots.map((slot) => {
                            const slotButton = document.createElement('button');
                            slotButton.className = 'service-card__availability-slot';
                            slotButton.type = 'button';
                            slotButton.textContent = formatTimeWithMeridiem(slot);
                            slotButton.dataset.localDate = localDate;
                            slotButton.dataset.startTime = slot;
                            slotButton.addEventListener('click', () => {
                                showBookingForm(service, availabilityPanel, slotButton);
                            });

                            return slotButton;
                        });

                        slotsStatus.hidden = true;
                        slotList.replaceChildren(...slotButtons);
                        scrollToBookingStep(slotsPanel);
                    })
                    .catch(() => {
                        slotsStatus.hidden = false;
                        slotsStatus.textContent = 'Cannot load bookable slots.';
                    })
                    .finally(() => {
                        dayButton.disabled = false;
                    });
            };
            const updateMonthNavigation = (availabilityPanel, yearMonth) => {
                const navigation = availabilityPanel.querySelector('[data-availability-nav]');
                const previousButton = availabilityPanel.querySelector('[data-availability-previous]');
                const nextButton = availabilityPanel.querySelector('[data-availability-next]');
                const currentYearMonth = getCurrentYearMonth();
                const previousYearMonth = addMonths(yearMonth, -1);
                const nextYearMonth = addMonths(yearMonth, 1);

                navigation.hidden = false;
                previousButton.hidden = previousYearMonth < currentYearMonth;
                previousButton.textContent = `Previous month ${formatMonthLabel(previousYearMonth)}`;
                nextButton.textContent = `Next month ${formatMonthLabel(nextYearMonth)}`;
            };
            const setAvailabilityControlsDisabled = (availabilityPanel, disabled) => {
                const buttons = availabilityPanel.querySelectorAll(
                    '[data-availability-previous], [data-availability-next]'
                );

                buttons.forEach((button) => {
                    button.disabled = disabled;
                });
            };
            const loadBookableDays = (service, availabilityPanel, bookButton, yearMonth = getCurrentYearMonth()) => {
                availabilityPanel.hidden = false;
                availabilityPanel.dataset.visibleMonth = yearMonth;
                updateMonthNavigation(availabilityPanel, yearMonth);
                resetBookableSlots(availabilityPanel);

                if (availabilityPanel.dataset.loadedMonth === yearMonth) {
                    scrollToBookingStep(availabilityPanel.querySelector('[data-availability-days]'));
                    return;
                }

                const title = availabilityPanel.querySelector('[data-availability-title]');
                const statusMessage = availabilityPanel.querySelector('[data-availability-status]');
                const daysList = availabilityPanel.querySelector('[data-availability-days]');

                title.textContent = `Bookable days in ${formatMonthLabel(yearMonth)}`;
                statusMessage.hidden = false;
                statusMessage.textContent = 'Loading bookable days...';
                daysList.replaceChildren();
                bookButton.disabled = true;
                setAvailabilityControlsDisabled(availabilityPanel, true);
                scrollToBookingStep(daysList);

                fetch(buildBookableDaysUrl(service.id, yearMonth), {
                    headers: {
                        'Accept': 'application/json',
                    },
                })
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error('Bookable days request failed.');
                        }

                        return response.json();
                    })
                    .then((bookableDays) => {
                        availabilityPanel.dataset.loadedMonth = yearMonth;

                        if (!Array.isArray(bookableDays) || bookableDays.length === 0) {
                            statusMessage.hidden = false;
                            statusMessage.textContent = 'No bookable days available this month.';
                            return;
                        }

                        const dayButtons = bookableDays.map((bookableDay) => {
                            const dayButton = document.createElement('button');
                            dayButton.className = 'service-card__availability-day';
                            dayButton.type = 'button';
                            dayButton.textContent = formatBookableDay(bookableDay);
                            dayButton.dataset.localDate = bookableDay;
                            dayButton.addEventListener('click', () => {
                                loadBookableSlots(service, availabilityPanel, dayButton);
                            });

                            return dayButton;
                        });

                        statusMessage.hidden = true;
                        daysList.replaceChildren(...dayButtons);
                        scrollToBookingStep(daysList);
                    })
                    .catch(() => {
                        statusMessage.hidden = false;
                        statusMessage.textContent = 'Cannot load bookable days.';
                    })
                    .finally(() => {
                        bookButton.disabled = false;
                        setAvailabilityControlsDisabled(availabilityPanel, false);
                    });
            };
            const createServiceCard = (service) => {
                const card = document.createElement('article');
                card.className = 'service-card';

                const header = document.createElement('div');
                header.className = 'service-card__header';

                const title = document.createElement('h3');
                title.className = 'service-card__name';
                title.textContent = capitalizeFirstLetter(service.name);

                const price = document.createElement('span');
                price.className = 'service-card__price';
                price.textContent = formatPrice(service.price_cents);

                header.append(title, price);

                const description = document.createElement('p');
                description.className = 'service-card__description';
                description.textContent = service.description || 'No description available.';

                const meta = document.createElement('div');
                meta.className = 'service-card__meta';

                const duration = document.createElement('span');
                duration.className = 'service-card__meta-pill';
                duration.textContent = formatDuration(service.duration_min);

                meta.append(duration);

                const bookButton = document.createElement('button');
                bookButton.className = 'service-card__book';
                bookButton.type = 'button';
                bookButton.textContent = 'Book this service';

                const availabilityPanel = document.createElement('div');
                availabilityPanel.className = 'service-card__availability';
                availabilityPanel.hidden = true;

                const availabilityTitle = document.createElement('p');
                availabilityTitle.className = 'service-card__availability-title';
                availabilityTitle.dataset.availabilityTitle = '';

                const availabilityNavigation = document.createElement('div');
                availabilityNavigation.className = 'service-card__availability-nav';
                availabilityNavigation.dataset.availabilityNav = '';
                availabilityNavigation.hidden = true;

                const previousMonthButton = document.createElement('button');
                previousMonthButton.className = 'service-card__availability-nav-button';
                previousMonthButton.type = 'button';
                previousMonthButton.dataset.availabilityPrevious = '';

                const nextMonthButton = document.createElement('button');
                nextMonthButton.className = 'service-card__availability-nav-button';
                nextMonthButton.type = 'button';
                nextMonthButton.dataset.availabilityNext = '';

                availabilityNavigation.append(previousMonthButton, nextMonthButton);

                const availabilityStatus = document.createElement('p');
                availabilityStatus.className = 'service-card__availability-status';
                availabilityStatus.dataset.availabilityStatus = '';

                const availabilityDays = document.createElement('div');
                availabilityDays.className = 'service-card__availability-days';
                availabilityDays.dataset.availabilityDays = '';

                const availabilitySlots = document.createElement('div');
                availabilitySlots.className = 'service-card__availability-slots';
                availabilitySlots.dataset.availabilitySlots = '';
                availabilitySlots.hidden = true;

                const availabilitySlotsTitle = document.createElement('p');
                availabilitySlotsTitle.className = 'service-card__availability-slots-title';
                availabilitySlotsTitle.dataset.availabilitySlotsTitle = '';

                const availabilitySlotsStatus = document.createElement('p');
                availabilitySlotsStatus.className = 'service-card__availability-slots-status';
                availabilitySlotsStatus.dataset.availabilitySlotsStatus = '';

                const availabilitySlotList = document.createElement('div');
                availabilitySlotList.className = 'service-card__availability-slot-list';
                availabilitySlotList.dataset.availabilitySlotList = '';

                availabilitySlots.append(
                    availabilitySlotsTitle,
                    availabilitySlotsStatus,
                    availabilitySlotList
                );

                const bookingForm = document.createElement('form');
                bookingForm.className = 'service-card__booking-form';
                bookingForm.dataset.bookingForm = '';
                bookingForm.hidden = true;

                const bookingTitle = document.createElement('p');
                bookingTitle.className = 'service-card__booking-form-title';
                bookingTitle.dataset.bookingFormTitle = '';

                const proIdInput = document.createElement('input');
                proIdInput.name = 'proId';
                proIdInput.type = 'hidden';

                const serviceIdInput = document.createElement('input');
                serviceIdInput.name = 'serviceId';
                serviceIdInput.type = 'hidden';

                const startDateTimeInput = document.createElement('input');
                startDateTimeInput.name = 'startDateTimeLocal';
                startDateTimeInput.type = 'hidden';

                const bookingFields = document.createElement('div');
                bookingFields.className = 'service-card__booking-fields';

                const lastNameField = document.createElement('div');
                lastNameField.className = 'service-card__booking-field';

                const lastNameLabel = document.createElement('label');
                lastNameLabel.textContent = 'Last name';

                const lastNameInput = document.createElement('input');
                lastNameInput.autocomplete = 'family-name';
                lastNameInput.maxLength = 50;
                lastNameInput.name = 'lastName';
                lastNameInput.required = true;
                lastNameInput.type = 'text';

                lastNameField.append(lastNameLabel, lastNameInput);

                const firstNameField = document.createElement('div');
                firstNameField.className = 'service-card__booking-field';

                const firstNameLabel = document.createElement('label');
                firstNameLabel.textContent = 'First name';

                const firstNameInput = document.createElement('input');
                firstNameInput.autocomplete = 'given-name';
                firstNameInput.maxLength = 50;
                firstNameInput.name = 'firstName';
                firstNameInput.required = true;
                firstNameInput.type = 'text';

                firstNameField.append(firstNameLabel, firstNameInput);

                const emailField = document.createElement('div');
                emailField.className = 'service-card__booking-field';

                const emailLabel = document.createElement('label');
                emailLabel.textContent = 'Email';

                const emailInput = document.createElement('input');
                emailInput.autocomplete = 'email';
                emailInput.name = 'email';
                emailInput.required = true;
                emailInput.type = 'email';

                emailField.append(emailLabel, emailInput);

                const phoneField = document.createElement('div');
                phoneField.className = 'service-card__booking-field';

                const phoneLabel = document.createElement('label');
                phoneLabel.textContent = 'Phone';

                const phoneInput = document.createElement('input');
                phoneInput.autocomplete = 'tel';
                phoneInput.maxLength = 30;
                phoneInput.minLength = 7;
                phoneInput.name = 'extraPhone';
                phoneInput.required = true;
                phoneInput.type = 'tel';

                phoneField.append(phoneLabel, phoneInput);
                bookingFields.append(lastNameField, firstNameField, emailField, phoneField);

                const bookingSubmit = document.createElement('button');
                bookingSubmit.className = 'service-card__booking-submit';
                bookingSubmit.dataset.bookingSubmit = '';
                bookingSubmit.type = 'submit';
                bookingSubmit.textContent = 'Confirm appointment';

                const bookingStatus = document.createElement('p');
                bookingStatus.className = 'service-card__booking-status';
                bookingStatus.dataset.bookingStatus = '';

                bookingForm.append(
                    bookingTitle,
                    proIdInput,
                    serviceIdInput,
                    startDateTimeInput,
                    bookingFields,
                    bookingSubmit,
                    bookingStatus
                );
                bookingForm.addEventListener('submit', submitBookingForm);

                availabilityPanel.append(
                    availabilityTitle,
                    availabilityNavigation,
                    availabilityStatus,
                    availabilityDays,
                    availabilitySlots,
                    bookingForm
                );

                bookButton.addEventListener('click', () => {
                    loadBookableDays(service, availabilityPanel, bookButton);
                });
                previousMonthButton.addEventListener('click', () => {
                    const previousYearMonth = addMonths(availabilityPanel.dataset.visibleMonth, -1);

                    if (previousYearMonth >= getCurrentYearMonth()) {
                        loadBookableDays(service, availabilityPanel, bookButton, previousYearMonth);
                    }
                });
                nextMonthButton.addEventListener('click', () => {
                    loadBookableDays(
                        service,
                        availabilityPanel,
                        bookButton,
                        addMonths(availabilityPanel.dataset.visibleMonth, 1)
                    );
                });

                card.append(header, description, meta, bookButton, availabilityPanel);

                return card;
            };
            const loadServices = (category, servicesPanel) => {
                servicesPanel.textContent = 'Loading services...';

                return fetch(`${serviceListUrl}?id=${encodeURIComponent(category.id)}`, {
                    headers: {
                        'Accept': 'application/json',
                    },
                })
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error('Service list request failed.');
                        }

                        return response.json();
                    })
                    .then((services) => {
                        servicesPanel.dataset.loaded = 'true';

                        if (!Array.isArray(services) || services.length === 0) {
                            servicesPanel.textContent = 'No services available in this category.';
                            return;
                        }

                        servicesPanel.replaceChildren(...services.map(createServiceCard));
                    })
                    .catch(() => {
                        servicesPanel.textContent = 'Cannot load services.';
                    });
            };
            const createCategoryItem = (category) => {
                const item = document.createElement('article');
                item.className = 'service-category';

                const toggle = document.createElement('button');
                toggle.className = 'service-category__toggle';
                toggle.type = 'button';
                toggle.setAttribute('aria-expanded', 'false');

                const main = document.createElement('span');
                main.className = 'service-category__main';

                const arrow = document.createElement('span');
                arrow.className = 'service-category__arrow';
                arrow.textContent = '>';

                const name = document.createElement('span');
                name.className = 'service-category__name';
                name.textContent = capitalizeFirstLetter(category.name);

                main.append(arrow, name);

                const servicesCount = Number(category.services_count || 0);
                const count = document.createElement('span');
                count.className = 'service-category__count';
                count.textContent = `${servicesCount} ${pluralizeServices(servicesCount)}`;

                toggle.append(main, count);

                const servicesPanel = document.createElement('div');
                servicesPanel.className = 'service-category__services';
                servicesPanel.hidden = true;

                toggle.addEventListener('click', () => {
                    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

                    if (isExpanded) {
                        toggle.setAttribute('aria-expanded', 'false');
                        arrow.textContent = '>';
                        servicesPanel.hidden = true;
                        return;
                    }

                    toggle.setAttribute('aria-expanded', 'true');
                    arrow.textContent = 'v';
                    servicesPanel.hidden = false;

                    if (servicesPanel.dataset.loaded !== 'true') {
                        loadServices(category, servicesPanel);
                    }
                });

                item.append(toggle, servicesPanel);

                return item;
            };

            fetch(categoryListUrl, {
                headers: {
                    'Accept': 'application/json',
                },
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error('Category list request failed.');
                    }

                    return response.json();
                })
                .then((categories) => {
                    if (!Array.isArray(categories) || categories.length === 0) {
                        setStatus('No category list available');
                        return;
                    }

                    if (status) {
                        status.remove();
                    }

                    list.replaceChildren(...categories.map(createCategoryItem));
                })
                .catch(() => {
                    setStatus('Cannot load categories');
                });
        })();
    </script>
{% endblock %}
