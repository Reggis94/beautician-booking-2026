{% extends 'base.html.twig' %}

{% block body %}
    <div class="page-content">
        {% if banner_urls|default([]) is not empty %}
            {% for bannerUrl in banner_urls %}
                <img src="{{ bannerUrl }}" alt="" loading="lazy" decoding="async" class="banner-image">
                {% if loop.index == 2 and demo_video_url|default(null) %}
                    <div class="demo-video-frame is-loading" data-demo-video-frame>
                        <video
                            class="demo-video"
                            src="{{ demo_video_url }}#t=780"
                            autoplay
                            muted
                            playsinline
                            preload="auto"
                            disablepictureinpicture
                            disableremoteplayback
                            aria-label="Vidéo de démonstration Nyebah"
                            data-demo-video
                        ></video>
                        <div class="demo-video-loader" role="status" aria-live="polite">
                            <span class="demo-video-loader__spinner" aria-hidden="true"></span>
                            <span>Loading media</span>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}

        <div class="demo-front-toolbar">
            <a href="{{ demo_admin_url }}" class="demo-front-toolbar__admin-link">Aller sur votre espace Pro</a>
        </div>

        {% if is_nyebah_demo|default(false) %}
            <iframe
                src="https://app.acuityscheduling.com/schedule.php?owner=40202245&amp;owner=40202245&amp;appointmentType=97386496"
                width="100%"
                height="800"
                frameborder="0"
                allow="payment"
                title="Prendre rendez-vous avec Nyebah"
            ></iframe>
            <script src="https://embed.acuityscheduling.com/js/embed.js" type="text/javascript"></script>
        {% else %}
            <section class="service-categories">
            <div class="service-categories__header">
                <p class="service-categories__eyebrow">Nos prestations</p>
                <h2>Services</h2>
                <p class="service-categories__sub">Choisissez une prestation et demandez un rendez-vous.</p>
            </div>

            <div class="service-categories__list">
                {% for category in demo_service_categories %}
                    <article class="service-category">
                        <button class="service-category__toggle" type="button" aria-expanded="true">
                            <span class="service-category__main">
                                <span class="service-category__arrow">&#8964;</span>
                                <span class="service-category__name">{{ category.name }}</span>
                            </span>
                            <span class="service-category__count">
                                {{ category.services|length }} {{ category.services|length > 1 ? 'prestations' : 'prestation' }}
                            </span>
                        </button>

                        <div class="service-category__services">
                            {% for service in category.services %}
                                <article class="service-card">
                                    <div class="service-card__header">
                                        <h3 class="service-card__name">{{ service.name }}</h3>
                                        <span class="service-card__price">{{ service.price }} €</span>
                                    </div>
                                    <p class="service-card__description">{{ service.description }}</p>
                                    <div class="service-card__meta">
                                        <span class="service-card__meta-pill">{{ service.durationMinutes }} min</span>
                                        <span class="service-card__meta-pill">Disponibilités</span>
                                    </div>
                                    <button
                                        class="service-card__book"
                                        type="button"
                                        data-demo-booking
                                        data-service-id="{{ service.id }}"
                                        data-service-name="{{ service.name }}"
                                    >
                                        Réserver cette prestation
                                    </button>
                                    <div class="service-card__availability" hidden data-availability-panel>
                                        <p class="service-card__availability-title" data-availability-title></p>

                                        <div class="service-card__availability-nav" data-availability-nav>
                                            <button
                                                class="service-card__availability-nav-button"
                                                type="button"
                                                data-availability-previous
                                            ></button>
                                            <button
                                                class="service-card__availability-nav-button"
                                                type="button"
                                                data-availability-next
                                            ></button>
                                        </div>

                                        <div class="service-card__availability-days" data-availability-days></div>

                                        <div class="service-card__availability-slots" hidden data-availability-slots>
                                            <p class="service-card__availability-slots-title" data-availability-slots-title></p>
                                            <div class="service-card__availability-slot-list" data-availability-slot-list></div>
                                        </div>

                                        <form class="service-card__booking-form" hidden data-booking-form>
                                            <p class="service-card__booking-form-title" data-booking-form-title></p>
                                            <input type="hidden" name="proId" value="1">
                                            <input type="hidden" name="serviceId" value="{{ service.id }}">
                                            <input type="hidden" name="startDateTimeLocal">

                                            <div class="service-card__booking-fields">
                                                <div class="service-card__booking-field">
                                                    <label>Nom</label>
                                                    <input name="lastName" type="text" autocomplete="family-name" maxlength="50" required>
                                                </div>
                                                <div class="service-card__booking-field">
                                                    <label>Prénom</label>
                                                    <input name="firstName" type="text" autocomplete="given-name" maxlength="50" required>
                                                </div>
                                                <div class="service-card__booking-field">
                                                    <label>Email</label>
                                                    <input name="email" type="email" autocomplete="email" required>
                                                </div>
                                                <div class="service-card__booking-field">
                                                    <label>Téléphone</label>
                                                    <input name="extraTéléphone" type="tel" autocomplete="tel" minlength="7" maxlength="30" required>
                                                </div>
                                            </div>

                                            <button class="service-card__booking-submit" type="submit">
                                                Confirmer le rendez-vous
                                            </button>
                                            <p class="service-card__booking-status" data-demo-booking-status></p>
                                        </form>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                    </article>
                {% endfor %}
            </div>
            </section>
        {% endif %}

        <footer class="demo-front-footer">
            <button class="demo-front-footer__legal-link" type="button" data-legal-modal-open>
                Mentions légales et CGV
            </button>
        </footer>
    </div>

    <div
        class="booking-result-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="demoBookingResultTitle"
        hidden
        data-booking-result-modal
    >
        <div class="booking-result-modal__backdrop" data-booking-result-close></div>
        <div class="booking-result-modal__dialog">
            <button class="booking-result-modal__close" type="button" aria-label="Fermer" data-booking-result-close>x</button>
            <p class="booking-result-modal__eyebrow">Rendez-vous demandé</p>
            <h2 class="booking-result-modal__title" id="demoBookingResultTitle">Merci, votre demande de rendez-vous a bien été envoyée</h2>
            <p class="booking-result-modal__body">
                Nous vous avons envoyé un e-mail avec les détails du rendez-vous. La professionnelle a également été prévenue.
            </p>
            <button class="booking-result-modal__action" type="button" data-booking-result-close>Fermer</button>
        </div>
    </div>

    <div
        class="demo-welcome-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="demoWelcomeTitle"
        aria-describedby="demoWelcomeBody"
        data-demo-welcome-modal
    >
        <div class="demo-welcome-modal__backdrop"></div>
        <div class="demo-welcome-modal__dialog">
            <p class="demo-welcome-modal__eyebrow">Bienvenue dans la démo</p>
            <h2 class="demo-welcome-modal__title" id="demoWelcomeTitle">Découvrez Glam4Style</h2>
            <p class="demo-welcome-modal__body" id="demoWelcomeBody">
                Profitez de notre offre en cours : seulement 40 € pour un an, soit 3,34 € par mois,
                au lieu de 96 € par an.
                <strong>Offre limitée jusqu’au 19 Août 2026</strong>
            </p>
            <button class="demo-welcome-modal__action" type="button" data-demo-welcome-close>
                Fermer et essayer Glam4Style
            </button>
        </div>
    </div>

    <div class="legal-modal" role="dialog" aria-modal="true" aria-labelledby="legalModalTitle" hidden data-legal-modal>
        <div class="legal-modal__backdrop" data-legal-modal-close></div>
        <section class="legal-modal__dialog">
            <button class="legal-modal__close" type="button" aria-label="Fermer" data-legal-modal-close>x</button>
            <p class="legal-modal__eyebrow">Informations juridiques</p>
            <h2 class="legal-modal__title" id="legalModalTitle">Mentions légales et CGV</h2>

            <div class="legal-modal__content">
                <section aria-labelledby="legalNoticesTitle">
                    <h3 id="legalNoticesTitle">Mentions légales</h3>
                    <h4>Éditeur du site</h4>
                    <p>Le site et la plateforme Glam4Style sont édités sous la marque Glam4Style. Contact : <a href="mailto:contact@glam4style.com">contact@glam4style.com</a>.</p>
                    <h4>Données personnelles</h4>
                    <p>Les formulaires de rendez-vous de cette démonstration demandent un nom, un prénom, une adresse e-mail et un numéro de téléphone uniquement pour illustrer le parcours. Aucune demande saisie dans la démo n’est enregistrée comme un véritable rendez-vous.</p>
                    <h4>Propriété intellectuelle et responsabilité</h4>
                    <p>Les contenus, textes, éléments graphiques et interfaces présentés sous la marque Glam4Style sont protégés. Toute reproduction non autorisée est interdite. Les données, disponibilités, prestations et tarifs affichés dans la démo sont fictifs et ne constituent pas une offre de service d’une professionnelle de beauté réelle.</p>
                </section>

                <section aria-labelledby="termsTitle">
                    <h3 id="termsTitle">Conditions générales de vente</h3>
                    <h4>Objet</h4>
                    <p>Les présentes conditions encadrent l’accès des professionnelles de la beauté à Glam4Style, une plateforme proposant notamment une page de réservation cliente et un espace professionnel pour gérer les rendez-vous, prestations et horaires.</p>
                    <h4>Accès et commande</h4>
                    <p>Pour demander un accès, la professionnelle écrit <strong>INTERESSE</strong> en commentaire sous la dernière publication TikTok de Glam4Style. L’utilisation de cette démo et l’envoi de ce commentaire ne valent ni commande ni paiement. Les informations contractuelles définitives sont communiquées avant tout engagement.</p>
                    <h4>Prix et durée</h4>
                    <p>L’offre présentée dans cette démo est de 40 € pour un an, soit 3,34 € par mois, au lieu de 96 € par an, et est annoncée comme limitée jusqu’au 19 août 2026. Le prix, les taxes applicables, la durée et les modalités de paiement sont confirmés à la professionnelle avant la conclusion de la vente.</p>
                    <h4>Mise à disposition du service</h4>
                    <p>Après validation de la commande, Glam4Style communique les modalités d’accès et de configuration de la plateforme. La professionnelle reste responsable de l’exactitude de ses prestations, tarifs, horaires, disponibilités et informations destinées à ses clientes.</p>
                    <h4>Réclamations, annulation et droit applicable</h4>
                    <p>Toute question ou réclamation peut être adressée à <a href="mailto:contact@glam4style.com">contact@glam4style.com</a>. Les conditions d’annulation, de remboursement, de renouvellement, ainsi que les règles relatives au droit de rétractation et au règlement des litiges, seront précisées dans les conditions définitives remises avant la commande, selon le statut de la cliente professionnelle et la législation applicable.</p>
                </section>
            </div>

            <button class="legal-modal__action" type="button" data-legal-modal-close>Fermer</button>
        </section>
    </div>

    <style>
        /* â”€â”€ TOKENS â”€â”€ */
        :root {
            --cream:       #FAF6F1;
            --blush:       #F2E0D6;
            --rose:        #D4998A;
            --rose-deep:   #B8765F;
            --charcoal:    #1C1916;
            --warm-grey:   #6B5F58;
            --mid:         #A89890;
            --soft-border: rgba(180,150,135,0.22);
            --serif: 'Cormorant Garamond', Georgia, serif;
            --sans:  'DM Sans', system-ui, sans-serif;
        }

        /* â”€â”€ LAYOUT â”€â”€ */
        .page-content {
            max-width: 1025px;
            margin: 0 auto;
            background: var(--cream);
            font-family: var(--sans);
            font-weight: 300;
            color: var(--charcoal);
        }
        .banner-image {
            display: block;
            height: auto;
            margin: 0;
            width: 100%;
        }
        .demo-video {
            display: block;
            height: auto;
            margin: 0;
            pointer-events: none;
            width: 100%;
        }
        .demo-video-frame {
            min-height: 240px;
            position: relative;
        }
        .demo-video-frame:not(.is-loading) {
            min-height: 0;
        }
        .demo-video-loader {
            align-items: center;
            background: var(--charcoal);
            color: var(--cream);
            display: none;
            flex-direction: column;
            font-size: 12px;
            gap: 14px;
            inset: 0;
            justify-content: center;
            letter-spacing: .12em;
            position: absolute;
            text-transform: uppercase;
        }
        .demo-video-frame.is-loading .demo-video-loader {
            display: flex;
        }
        .demo-video-loader__spinner {
            animation: demo-video-spin .8s linear infinite;
            border: 3px solid rgba(250, 246, 241, .3);
            border-radius: 50%;
            border-top-color: var(--cream);
            height: 30px;
            width: 30px;
        }
        @keyframes demo-video-spin {
            to { transform: rotate(360deg); }
        }


        /* â”€â”€ TOOLBAR â”€â”€ */
        .demo-front-toolbar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 14px 24px;
            border-bottom: 1px solid var(--soft-border);
        }
        .demo-front-toolbar__admin-link {
            font-family: var(--sans);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--cream);
            background: var(--charcoal);
            padding: 9px 18px;
            text-decoration: none;
            transition: background .18s;
        }
        .demo-front-toolbar__admin-link:hover {
            background: var(--rose-deep);
            color: var(--cream);
        }
        .demo-front-footer {
            border-top: 1px solid var(--soft-border);
            padding: 22px 24px 86px;
            text-align: center;
        }
        .demo-front-footer__legal-link {
            background: none;
            border: 0;
            color: var(--warm-grey);
            cursor: pointer;
            font: 500 12px/1.4 var(--sans);
            padding: 6px;
            text-decoration: underline;
            text-underline-offset: 3px;
        }
        .demo-front-footer__legal-link:hover,
        .demo-front-footer__legal-link:focus { color: var(--rose-deep); }

        /* â”€â”€ SECTION HEADER â”€â”€ */
        .service-categories {
            padding: 48px 24px 60px;
        }
        .service-categories__header {
            margin-bottom: 36px;
        }
        .service-categories__eyebrow {
            font-size: 10px;
            font-weight: 500;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--rose-deep);
            margin: 0 0 10px;
        }
        .service-categories__header h2 {
            font-family: var(--serif);
            font-size: clamp(28px, 4vw, 42px);
            font-weight: 300;
            line-height: 1.15;
            margin: 0 0 8px;
            color: var(--charcoal);
        }
        .service-categories__sub {
            font-size: 14px;
            color: var(--warm-grey);
            margin: 0;
            line-height: 1.6;
        }

        /* â”€â”€ CATEGORY â”€â”€ */
        .service-categories__list {
            display: grid;
            gap: 16px;
        }
        .service-category {
            border: 1px solid var(--soft-border);
            background: var(--cream);
            overflow: hidden;
        }
        .service-category__toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            background: var(--cream);
            border: 0;
            padding: 18px 20px;
            text-align: left;
            cursor: default;
            min-height: 56px;
            border-bottom: 1px solid var(--soft-border);
        }
        .service-category__main {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .service-category__arrow {
            font-size: 18px;
            color: var(--mid);
            line-height: 1;
            width: 16px;
        }
        .service-category__name {
            font-family: var(--serif);
            font-size: 20px;
            font-weight: 400;
            color: var(--charcoal);
        }
        .service-category__count {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--mid);
        }

        /* â”€â”€ SERVICE CARDS â”€â”€ */
        .service-category__services {
            background: var(--blush);
            display: grid;
            gap: 1px;
            padding: 0;
            border-top: none;
        }
        .service-card {
            background: var(--cream);
            padding: 24px 20px 24px 32px;
            position: relative;
            transition: background .18s;
        }
        .service-card:hover { background: #FEFCF9; }

        .service-card__header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 6px;
        }
        .service-card__name {
            font-family: var(--serif);
            font-size: 22px;
            font-weight: 400;
            margin: 0;
            color: var(--charcoal);
            line-height: 1.2;
        }
        .service-card__price {
            font-family: var(--serif);
            font-size: 22px;
            font-weight: 300;
            color: var(--rose-deep);
            white-space: nowrap;
            flex-shrink: 0;
        }
        .service-card__description {
            font-size: 13px;
            color: var(--warm-grey);
            margin: 0 0 14px;
            line-height: 1.65;
        }
        .service-card__meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 16px;
        }
        .service-card__meta-pill {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .08em;
            color: var(--warm-grey);
            background: var(--blush);
            border: 1px solid var(--soft-border);
            padding: 4px 10px;
        }

        /* â”€â”€ BOOK BUTTON â”€â”€ */
        .service-card__book {
            font-family: var(--sans);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--cream);
            background: var(--charcoal);
            border: none;
            padding: 11px 22px;
            cursor: pointer;
            transition: background .18s, transform .12s;
        }
        .service-card__book:hover {
            background: var(--rose-deep);
            transform: translateY(-1px);
        }

        /* â”€â”€ AVAILABILITY PANEL â”€â”€ */
        .service-card__availability {
            border-top: 1px solid var(--soft-border);
            margin-top: 20px;
            padding-top: 20px;
        }
        .service-card__availability-title {
            font-family: var(--serif);
            font-size: 17px;
            font-weight: 400;
            color: var(--charcoal);
            margin: 0 0 14px;
        }

        /* nav buttons */
        .service-card__availability-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }
        .service-card__availability-nav-button {
            font-family: var(--sans);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .08em;
            color: var(--warm-grey);
            background: var(--cream);
            border: 1px solid var(--soft-border);
            padding: 8px 14px;
            cursor: pointer;
            transition: border-color .18s, color .18s, background .18s;
        }
        .service-card__availability-nav-button:hover {
            border-color: var(--rose);
            color: var(--rose-deep);
            background: var(--blush);
        }

        /* day buttons */
        .service-card__availability-days,
        .service-card__availability-slot-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 0;
        }
        .service-card__availability-day {
            font-family: var(--sans);
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .06em;
            color: var(--warm-grey);
            background: var(--blush);
            border: 1px solid var(--soft-border);
            padding: 8px 14px;
            cursor: pointer;
            transition: border-color .18s, color .18s, background .18s;
        }
        .service-card__availability-day:hover {
            border-color: var(--rose);
            color: var(--rose-deep);
        }
        .service-card__availability-day.is-selected {
            background: var(--charcoal);
            border-color: var(--charcoal);
            color: var(--cream);
        }

        /* slots */
        .service-card__availability-slots {
            border-top: 1px solid var(--soft-border);
            margin-top: 16px;
            padding-top: 16px;
        }
        .service-card__availability-slots-title {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--mid);
            margin: 0 0 12px;
        }
        .service-card__availability-slot {
            font-family: var(--sans);
            font-size: 12px;
            font-weight: 500;
            letter-spacing: .06em;
            color: var(--warm-grey);
            background: var(--cream);
            border: 1px solid var(--soft-border);
            padding: 8px 14px;
            cursor: pointer;
            transition: border-color .18s, color .18s, background .18s;
        }
        .service-card__availability-slot:hover {
            border-color: var(--rose);
            color: var(--rose-deep);
            background: var(--blush);
        }
        .service-card__availability-slot.is-selected {
            background: var(--rose-deep);
            border-color: var(--rose-deep);
            color: var(--cream);
        }

        /* â”€â”€ BOOKING FORM â”€â”€ */
        .service-card__booking-form {
            border-top: 1px solid var(--soft-border);
            display: grid;
            gap: 16px;
            margin-top: 20px;
            padding-top: 20px;
        }
        .service-card__booking-form-title {
            font-family: var(--serif);
            font-size: 17px;
            font-weight: 400;
            color: var(--charcoal);
            margin: 0;
        }
        .service-card__booking-fields {
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
        }
        .service-card__booking-field {
            display: grid;
            gap: 6px;
        }
        .service-card__booking-field label {
            font-size: 10px;
            font-weight: 500;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--warm-grey);
        }
        .service-card__booking-field input {
            font-family: var(--sans);
            font-size: 14px;
            color: var(--charcoal);
            background: var(--blush);
            border: 1px solid var(--soft-border);
            padding: 11px 14px;
            outline: none;
            transition: border-color .18s;
            border-radius: 0;
            -webkit-appearance: none;
        }
        .service-card__booking-field input:focus {
            border-color: var(--rose);
        }
        .service-card__booking-field input::placeholder {
            color: var(--mid);
        }

        /* submit */
        .service-card__booking-submit {
            font-family: var(--sans);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--cream);
            background: var(--rose-deep);
            border: none;
            padding: 13px 28px;
            cursor: pointer;
            justify-self: start;
